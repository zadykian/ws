{
  "theme": { "mode": {{.Mode}}, "light": {{.Light}}, "dark": {{.Dark}} },
  "ui_font_family": {{.Font}},
  "buffer_font_family": {{.Font}},
  "terminal": {
    "dock": "right",
    "font_family": {{.Font}},
    "option_as_meta": true,
    "detect_venv": "off"
  },
  "base_keymap": "Zed",
  "project_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "auto_install_extensions": {
    "jetbrains-themes": true,
    "csharp": true,
    "sql": true,
    "postgres-language-server": true,
    "dockerfile": true,
    "make": true,
    "ansible": true,
    "html": true,
    "docker-compose": false
  },
  "languages": {
    "C# Project File": { "hard_tabs": false, "tab_size": 2 },
    "MSBuild File": { "hard_tabs": false, "tab_size": 2 },
    "C# Solution File": { "hard_tabs": false, "tab_size": 2 }
  }
}
