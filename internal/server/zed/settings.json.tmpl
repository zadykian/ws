{
  "terminal": { "shell": "system" },
  "lsp": {
    "gopls": {
      "binary": { "path": {{.Gopls}}, "arguments": ["-mode=stdio"] }
    },
    "roslyn": {
      "binary": {
        "path": {{.Roslyn}},
        "arguments": ["--stdio", "--autoLoadProjects", "--telemetryLevel", "off"]
      }
    }
  },
  "dap": { "Delve": { "binary": {{.Dlv}} } }
}
