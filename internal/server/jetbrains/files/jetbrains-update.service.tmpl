# Written by github.com/zadykian/ws, whose next run replaces any change made here. It runs the
# jetbrains role with root's copy of the ws that wrote it, and the values in /etc/ws/host_vars.yml.
# WS_JETBRAINS_RUN gives its downloads a directory of their own, so that neither this run nor one
# by hand removes the other's. Its output goes to the journal.
[Unit]
Description=Update JetBrains Gateway's backends
Documentation=https://github.com/zadykian/ws/blob/main/docs/jetbrains.md#the-timer
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=WS_JETBRAINS_RUN=timer
Nice=10
IOSchedulingClass=idle
ExecStart={{ .Exe }} server apply --only jetbrains
