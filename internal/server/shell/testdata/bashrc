# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples
#
# Written by github.com/zadykian/ws, whose next run replaces any change made here. Settings of
# your own go in ~/.bash_aliases, which this file sources.

# The machine's secrets, where it has them. Above the interactive guard below, so that
# non-interactive shells get them too.
if [ -f "$HOME/.secrets/env" ]; then
    source "$HOME/.secrets/env"
fi

# Ubuntu's .NET SDK runs as ubuntu.26.04-x64, which NuGet's runtime graph, frozen after .NET 8,
# lacks. `dotnet tool install` then finds no tool assets and fails with "DotnetToolSettings.xml was
# not found in the package". The portable ID works. Above the guard too.
export DOTNET_RUNTIME_ID=linux-x64

# A login with a terminal, outside tmux, runs in a tmux of its own, whose status line holds the
# host's load (docs/shell.md#the-hosts-load). Its shell, or ssh's command, runs there, and its exit
# status is the login's. A hangup ends it. LC_WS_BAR=off skips it, and so do a login with no
# terminal, as Zed's server's, and Zed's terminal, whose own tmux holds the line. Where the command
# cannot be written, or tmux never starts the pane, the login goes on here. So a full /tmp or a
# broken tmux never loses the command or shuts ssh out. Above the guard, which ssh's command never
# passes. WS_BAR_LOGIN marks each process that the tmux starts, so that no shell in it ever
# starts another, even one that tmux gives no TMUX.
if [[ -n ${SSH_TTY-} && -z ${TMUX-} && -z ${WS_BAR_LOGIN-} && ${LC_WS_BAR-} != off && -t 0 &&
    -t 1 && ${BASH_EXECUTION_STRING-} != */usr/local/lib/ws/zed/terminal* ]] &&
    [[ -r /usr/local/lib/ws/zed/tmux.conf ]] && command -v tmux >/dev/null 2>&1 &&
    __ws_bar=$(mktemp -d 2>/dev/null); then
    trap 'rm -rf -- "$__ws_bar"; exit 129' HUP
    # The pane notes that it started, runs the command or a login shell, and keeps its history and
    # screen, then its status. Those print here, as tmux's own screen leaves with tmux, and its
    # [exited] goes to /dev/null. The status is in an empty file's name, which a full /tmp still
    # takes. The pane outlives a Ctrl-C or Ctrl-\ that ends the command, so that it keeps them. A
    # session that loses its client, as on a hangup, ends, and its server with it. The server's
    # socket is in the directory, so that none outlives the login.
    if [[ -z ${BASH_EXECUTION_STRING-} ]] ||
        printf %s "$BASH_EXECUTION_STRING" 2>/dev/null >"$__ws_bar/command"; then
        WS_BAR_LOGIN=1 tmux -S "$__ws_bar/tmux" -f /usr/local/lib/ws/zed/tmux.conf \
            new-session bash -c 'trap : INT QUIT
        : >"$1/started" || exit
        if [[ -f $1/command ]]; then bash -c "$(<"$1/command")"; else "${SHELL:-/bin/bash}" -l; fi
        s=$?; tmux -S "$1/tmux" capture-pane -epJ -S - -E - >"$1/screen"; : >"$1/status.$s"' \
            ws-bar "$__ws_bar" \; \
            set-option destroy-unattached on >/dev/null
    fi
    if [[ -e $__ws_bar/started ]]; then
        __ws_status=("$__ws_bar"/status.*)
        __ws_status=${__ws_status[0]##*/status.}
        [[ $__ws_status =~ ^[0-9]+$ ]] || __ws_status=129
        __ws_screen=$(cat -- "$__ws_bar/screen" 2>/dev/null)
        [[ -z $__ws_screen ]] || printf '%s\e[m\n' "$__ws_screen"
        rm -rf -- "$__ws_bar"
        exit "$__ws_status"
    fi
    rm -rf -- "$__ws_bar"
    trap - HUP
    unset __ws_bar
fi

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# ble.sh replaces readline: suggestions from history as you type (Right accepts, Alt-f one word),
# syntax highlighting and a Tab menu fed by bash-completion. It attaches at the first prompt, its
# default, rather than here. A terminal that sources this file and only then installs its
# PROMPT_COMMAND and DEBUG trap would print "[ble: press RET to continue]" after every command
# (ble.sh#709). The default suggestion face has a grey background, a box on dark themes, and the
# default errexit mark prints "[ble: exit N]" after every failing command.
[[ $- == *i* && -f /usr/share/blesh/ble.sh ]] && source -- /usr/share/blesh/ble.sh
if [[ ${BLE_VERSION-} ]]; then
    ble-face auto_complete=fg=242
    bleopt exec_errexit_mark=
fi

# don't put duplicate lines in the history. See bash(1) for more options
# ... or force ignoredups and ignorespace
HISTCONTROL=ignoredups:ignorespace

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability. Off by default to not distract
# the user: the focus in a terminal window should be on the output of commands, not on the prompt.
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac
# In the login's tmux too, so that the Mac's terminal shows it. Zed's tmux leaves the title to a
# program (docs/zed.md#terminals-in-tmux).
if [[ -n ${WS_BAR_LOGIN-} && $TERM == tmux* ]]; then
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
fi

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# bash-completion, which ble.sh's Tab menu and the completions in
# ~/.local/share/bash-completion/completions, cld's among them, need. A login shell has it from
# /etc/profile already.
if [ -z "${BASH_COMPLETION_VERSINFO-}" ] && ! shopt -oq posix &&
    [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi
