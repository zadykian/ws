# Written by github.com/zadykian/ws, whose next run with shell_git_credentials replaces any change
# made here. ~/.gitconfig includes it after gh's helper (docs/shell.md#git-credentials).
# The tokens of shell_git_credentials, each URL's in a file of the role's. The helper hands it to
# git for get alone, so that store and erase leave the file as written. Of two sections whose URLs
# match, the last wins, so the URLs go in order, each after those it extends.
{{ range .Sections -}}
[credential "{{ .URL }}"]
	helper =
	helper = "!f() { test \"$1\" != get || cat ~/.config/git/tokens/{{ .File }}; }; f"
{{ if .Proactive -}}
[http "{{ .URL }}"]
	proactiveAuth = basic
{{ end -}}
{{ end -}}
