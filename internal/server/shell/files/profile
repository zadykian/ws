# ~/.profile: executed by Bourne-compatible login shells.
#
# Written by github.com/zadykian/ws, whose next run replaces any change made here.

# Where the playbook's roles install tools: claude and cld in ~/.local/bin, Go in
# /usr/local/go/bin, what `go install` builds, gopls among them, in ~/go/bin, and .NET's global
# tools in ~/.dotnet/tools. Each is added once, as a login shell started from another one, as tmux
# starts them, inherits a PATH that has it already.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
case ":$PATH:" in *":/usr/local/go/bin:"*) ;; *) PATH="$PATH:/usr/local/go/bin" ;; esac
case ":$PATH:" in *":$HOME/go/bin:"*) ;; *) PATH="$PATH:$HOME/go/bin" ;; esac
case ":$PATH:" in *":$HOME/.dotnet/tools:"*) ;; *) PATH="$PATH:$HOME/.dotnet/tools" ;; esac
export PATH

# rustup's env file puts ~/.cargo/bin first on PATH, once too.
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

# After PATH, so that ~/.bashrc runs with the session's.
if [ "$BASH" ]; then
  if [ -f ~/.bashrc ]; then
    . ~/.bashrc
  fi
fi
