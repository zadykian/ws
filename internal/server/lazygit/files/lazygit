#!/bin/sh
# Written by github.com/zadykian/ws, whose next run replaces any change made here.
# lazygit sets no title, so a tab keeps the shell's. This names the repository and its branch in
# the title, and gets the shell's back from the terminal's stack when lazygit ends.
if [ ! -t 0 ] || [ ! -t 1 ]; then
    exec /usr/bin/lazygit "$@"
fi
# title prints NAME: BRANCH for the directory $1, or nothing outside a work tree. A linked worktree
# takes its main tree's name, and a detached HEAD its short hash. Control characters are dropped,
# as a directory's name may hold an escape.
title() {
    top=
    common=
    {
        read -r top
        read -r common
    } <<EOF
$(git -C "$1" rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null)
EOF
    [ -n "$common" ] || return 0
    case $common in
    */.git) name=${common%/.git} ;;
    *) name=$top ;;
    esac
    branch=$(git -C "$1" symbolic-ref --short -q HEAD) ||
        branch=$(git -C "$1" rev-parse --short HEAD 2>/dev/null)
    printf '%s: %s' "${name##*/}" "$branch" | tr -d '\000-\037\177'
}
printf '\033[22;2t'
shown=$(title .)
[ -z "$shown" ] || printf '\033]2;%s\007' "$shown"
/usr/bin/lazygit "$@"
status=$?
printf '\033[23;2t'
exit "$status"
