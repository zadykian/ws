# The files' encoding, line ends and indents, for editors that read it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,yml.j2,yaml.j2,json.j2}]
indent_size = 2

# make takes a recipe's lines after a tab. The git config template and plists keep the tabs that
# git config and plutil write. A glob that holds a / matches from this directory alone, so the
# plists, in macos/roles/tunnel/files/, take a section of their own.
[{Makefile,roles/server/ubuntu/git/files/ws.gitconfig.tmpl}]
indent_style = tab

# The template's empty `helper =` lines end in a space, as gh writes them, so that the file stays
# the one the role wrote before.
[roles/server/ubuntu/git/files/ws.gitconfig.tmpl]
trim_trailing_whitespace = false

[*.plist]
indent_style = tab

# gofmt indents with tabs.
[*.go]
indent_style = tab
