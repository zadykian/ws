# devtools' units. mise installs Go and the servers as tools under root's data directory,
# /root/.local/share/mise, by the versions of mise.guest.toml's [tools]. The first units give each
# a path that names no version; the rest set up root's tools and gh. README.md says why each
# stands.

# Each link names its tool's version, which a bump of [tools] changes with it: a link to `latest`
# would keep a newer version that a downgrade leaves installed. shell's profile puts
# /usr/local/go/bin on PATH, and gopls runs the go it finds there.
[file.devtools-go]
path = "/usr/local/go"
link = "/root/.local/share/mise/installs/go/1.27.3"

[file.devtools-gopls]
path = "/usr/local/bin/gopls"
link = "/root/.local/share/mise/installs/go-golang-org-x-tools-gopls/0.23.0/bin/gopls"

[file.devtools-dlv]
path = "/usr/local/bin/dlv"
link = "/root/.local/share/mise/installs/go-github-com-go-delve-delve-cmd-dlv/1.27.2/bin/dlv"

[file.devtools-pgls]
path = "/usr/local/bin/postgres-language-server"
link = "/root/.local/share/mise/installs/github-supabase-community-postgres-language-server/0.28.2/postgres-language-server"

[file.devtools-docker-ls]
path = "/usr/local/bin/docker-language-server"
link = "/root/.local/share/mise/installs/github-docker-docker-language-server/0.20.1/docker-language-server"

# .NET's SDKs side by side in one root, from Microsoft's tarballs: Ubuntu's archive holds 10.0.1xx
# alone, and no .NET 11. The later archive's dotnet and host are the newer. A bump pins the SHA-256
# of a file whose SHA-512 matches its channel's releases.json (README.md).
[tree.devtools-dotnet]
path = "/usr/local/share/dotnet"
arch_names = { amd64 = "x64" }

[[tree.devtools-dotnet.archive]]
version = "10.0.404"
url = "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-{arch}.tar.gz"
sha256 = { amd64 = "c0610757a818fde4b960d27a0ac421f273068a05dc5ec7abafc01dbf84e9cb4d", arm64 = "dcc820a4277ab6bb3f648c609d86f2a7912ba9a3d166545e7b95dff419c12f0f" }

[[tree.devtools-dotnet.archive]]
version = "11.0.100"
url = "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-{arch}.tar.gz"
sha256 = { amd64 = "6fdb8822f47ccdba28f507dcd5d92e632d5b99cd27908d6838f0cc575be33baf", arm64 = "699951697c76af6ba714fbbe9b45372d1f189d00f303a67ba2e90d53acf630b2" }

# dotnet on every PATH, root's. Through the link, it finds the SDKs beside its own file.
[file.devtools-dotnet]
after = "tree/devtools-dotnet"
path = "/usr/local/bin/dotnet"
link = "/usr/local/share/dotnet/dotnet"

# A tool's own program, such as roslyn-language-server, finds .NET by this file, and else looks in
# /usr/share/dotnet alone. The file takes no mark, as its first line is the path.
[file.devtools-dotnet-location]
after = "tree/devtools-dotnet"
path = "/etc/dotnet/install_location"
source = "files/install_location"

# Root's tools. Each runs as root. Its commands get the system's PATH, where mise's packages put npm
# and gh, and file/devtools-dotnet puts dotnet.

# The npm servers, from a lock that pins each package by its sha512 integrity. The files go in as
# root's, with their missing directories. npm ci refuses a lock that disagrees with
# package.json, or a download whose integrity differs. Its stamp holds the sums of both files: a
# bump of either, or a node_modules removed, runs it again.
[file.devtools-npm-lock]
owner = "root"
path = "/root/.local/lib/language-servers/package-lock.json"
source = "files/npm/package-lock.json"

[file.devtools-npm-package]
after = "file/devtools-npm-lock"
owner = "root"
path = "/root/.local/lib/language-servers/package.json"
source = "files/npm/package.json"

[state.devtools-npm]
after = "file/devtools-npm-package"

[state.devtools-npm.run]
user = "root"
command = [
    "sh",
    "-c",
    'cd "$1" && npm ci --ignore-scripts --no-audit --no-fund --no-update-notifier && sha256sum package.json package-lock.json >node_modules/.ws-sha256',
    "sh",
    "/root/.local/lib/language-servers",
]
check = ["sh", "-c", 'cd "$1" && sha256sum -c --status node_modules/.ws-sha256', "sh", "/root/.local/lib/language-servers"]

# sql-formatter on every PATH, root's, so a project's settings name the bare command.
[file.devtools-sql-formatter]
after = "state/devtools-npm"
path = "/usr/local/bin/sql-formatter"
link = "/root/.local/lib/language-servers/node_modules/.bin/sql-formatter"

# gh 2.91.0 and later send telemetry unless told not to. GH_TELEMETRY=0 keeps the read and the set
# from sending any themselves.
[state.devtools-gh-telemetry.run]
user = "root"
command = ["env", "GH_TELEMETRY=0", "gh", "config", "set", "telemetry", "disabled"]
check = ["sh", "-c", '[ "$(GH_TELEMETRY=0 gh config get telemetry)" = disabled ]']

# gh logs in by the token file, after the telemetry. ws reads the token
# and gives it to gh on its input, as the account, so it never reaches a command's arguments. A plan
# writes no file, so in the secrets task's run ws reads WS_GITHUB_TOKEN, and the plan shows the
# login that the run makes. Without a token, gh's login stays unchanged. ws has no keyring, so gh
# keeps the token in ~/.config/gh/hosts.yml, mode 0600.
[state.devtools-gh-login]
after = "state/devtools-gh-telemetry"
run = { user = "root", command = ["{{ self }}", "ubuntu", "guest", "devtools", "gh-login"], check = ["{{ self }}", "ubuntu", "guest", "devtools", "gh-login", "--check"] }

# roslyn-language-server, C#'s server, from nuget.org, where every version is a prerelease. The
# version alone pins it, as nuget.org refuses a version's second upload. From 5.13.0-1.26514.10 the
# server defaults telemetry to all (roslyn#86066): a bump adds --telemetryLevel off to every command
# that starts it. update installs it where missing too, and --allow-downgrade lets the pin go back.
# NuGet asks every feed of root's NuGet config, and one it cannot reach fails the install,
# so --source asks nuget.org alone. The store keeps a directory per version, in lower case. dotnet
# warns where PATH lacks its tools' directory, and as root writes a profile.d script that adds it,
# so the unit puts it first. DOTNET_NOLOGO keeps its first run's welcome and advice off.
[state.devtools-roslyn]
after = "file/devtools-dotnet"

[state.devtools-roslyn.run]
user = "root"
path = ["/root/.dotnet/tools"]
command = [
    "env",
    "DOTNET_CLI_TELEMETRY_OPTOUT=1",
    "DOTNET_NOLOGO=1",
    "dotnet",
    "tool",
    "update",
    "--global",
    "roslyn-language-server",
    "--version",
    "5.12.0-1.26475.2",
    "--allow-downgrade",
    "--source",
    "https://api.nuget.org/v3/index.json",
]
check = [
    "sh",
    "-c",
    '[ "$(ls "$1")" = "$2" ]',
    "sh",
    "/root/.dotnet/tools/.store/roslyn-language-server",
    "5.12.0-1.26475.2",
]

# rustup and Rust's stable toolchain, in ~/.cargo and ~/.rustup, where missing: rustup updates
# itself and its toolchains. Its flag leaves PATH to /etc/ws/profile, which sources rustup's env
# file.
[state.devtools-rustup.run]
user = "root"
creates = ["/root/.cargo/bin/rustup"]
command = [
    "bash",
    "-c",
    "set -o pipefail && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain stable",
]
