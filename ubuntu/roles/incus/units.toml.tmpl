# The incus role's units. mise adds Zabbly's repository, the packages and the ID range first. Each
# unit makes one object in Incus by a command of ws's, whose --check fails where a change is due.
# README.md says what each holds.

# The ZFS pool, on the partition that WS_INCUS_POOL_SOURCE names.
[state.incus-pool]
run = { user = "root", command = ["{{ self }}", "ubuntu", "host", "incus", "pool"], check = ["{{ self }}", "ubuntu", "host", "incus", "pool", "--check"] }
