# The incus role's units. mise adds Zabbly's repository, the packages and the ID range first. Each
# unit makes one object in Incus by a command of ws's, whose --check fails where a change is due.
# README.md says what each holds. The order is the ACL, the pool, the bridge, then the profile: the
# bridge names the ACL, and the profile names the bridge and the pool.

# The egress ACL: the private ranges dropped, the rest allowed.
[state.incus-acl]
run = { user = "root", command = ["{{ self }}", "ubuntu", "host", "incus", "acl"], check = ["{{ self }}", "ubuntu", "host", "incus", "acl", "--check"] }

# The ZFS pool, on the partition that WS_INCUS_POOL_SOURCE names.
[state.incus-pool]
after = "state/incus-acl"
run = { user = "root", command = ["{{ self }}", "ubuntu", "host", "incus", "pool"], check = ["{{ self }}", "ubuntu", "host", "incus", "pool", "--check"] }

# The bridge incusbr0, at WS_INCUS_BRIDGE_ADDRESS, with the ACL on it.
[state.incus-bridge]
after = "state/incus-pool"
run = { user = "root", command = ["{{ self }}", "ubuntu", "host", "incus", "bridge"], check = ["{{ self }}", "ubuntu", "host", "incus", "bridge", "--check"] }

# The profile that each guest takes.
[state.incus-profile]
after = "state/incus-bridge"
run = { user = "root", command = ["{{ self }}", "ubuntu", "host", "incus", "profile"], check = ["{{ self }}", "ubuntu", "host", "incus", "profile", "--check"] }

# ufw lets the guests' DHCP in and routes what the guests send, which the egress ACL narrows. DNS
# to the host stays shut: the bridge hands out other resolvers. UDP 67 comes in from any address,
# as a guest asks before it holds one. A host's alone: a guest holds no filter.
[state.incus-ufw]
after = "state/incus-profile"
when = { side = "host" }

[state.incus-ufw.ufw]
comment = "incus: the guests' DHCP and routes"
rules = [
  { action = "allow", proto = "udp", to_port = "67", dir = "in", interface = "incusbr0" },
  { action = "allow", interface = "incusbr0", out = "any" },
]

# The table of guest sources, in nftables' bridge family. The table in force, with its hook chains,
# is compared with the table that the file loads in a network namespace of its own. So a table
# flushed by hand, or a hook that is lost, reloads. The set's elements are no part of that: the
# guests fill them, and a reload empties them. -s leaves out the counters' values, and -t the set's
# elements. A host's alone, as it filters.
[service.incus-sources]
unit = "incus-sources.service"
enabled = true
run = "running"
reload = true
in_force = ["nft", "-s", "-t", "list", "table", "bridge", "ws_sources"]
loads = [
    "unshare",
    "--net",
    "sh",
    "-c",
    'nft -f "$1" && nft -s -t list table bridge ws_sources',
    "sh",
    "/usr/local/lib/ws/incus/sources.nft",
]
after = "state/incus-profile"
when = { side = "host" }

[[service.incus-sources.file]]
path = "/usr/local/lib/ws/incus/sources.nft"
template = "files/sources.nft.tmpl"
check = ["/usr/sbin/nft", "-c", "-f", "{}"]

[[service.incus-sources.file]]
path = "/etc/systemd/system/incus-sources.service"
source = "files/incus-sources.service"
