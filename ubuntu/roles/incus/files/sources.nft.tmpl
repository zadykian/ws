# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# A guest sends from its own address alone, in the bridge's subnet. Incus's MAC filter holds its
# MAC, and this table holds its addresses. Incus's IPv4 filter would drop the VPN's replies, which
# leave a guest under a source that is not its own. So the table passes such a source toward the
# guest's own slot alone, where its tunnel's peers are. It filters at the bridge, from a guest's
# port, before any ACL. An ARP sender or a source address in the bridge's subnet or the tunnel's
# slots must be one that the port owns. The slot's address of a guest is its own. A lease asked
# from 0.0.0.0 passes too. Any other IPv4 source drops: Incus's NAT rewrites the bridge's subnet
# alone, so it would leave the host unchanged.
#
# What comes in by a guest's port takes the guest's mark. The way out by a guest's tunnel interface
# asks for that mark, in a table of its own. So no guest sends into another guest's tunnel under a
# source that the first table passes, such as a forged reply of the VPN.
#
# A frame of another ether type drops first. A VLAN tag would hide a source from the rules below,
# and the host strips the tag and takes the frame.
#
# The set owned4 holds the addresses of the guests, each with the name of its port. The load fills
# it, so a boot or a reload leaves no moment when a running guest owns no address. The ranges sit
# in the rules, not in a set: the kernel fills a set of ranges after its rules take effect, and a
# packet may pass a reload.
destroy table bridge ws_sources
destroy table ip ws_guest_out

table bridge ws_sources {
    # An address of a guest, its slot's too, with the port that carries it.
    set owned4 {
        type ipv4_addr . ifname
{{- if .Incus.Guests }}
        elements = { {{ range $i, $s := .Incus.Sources }}{{ if $i }}, {{ end }}{{ $s.Address }} . "{{ $s.Port }}"{{ end }} }
{{- end }}
    }

    chain from_guest {
        ether type != { arp, ip, ip6 } drop
{{- range .Incus.Guests }}
        iifname "{{ .Port }}" meta mark set {{ .Mark }}
{{- end }}
        ether type arp arp saddr ip . iifname @owned4 accept
        ether type arp arp saddr ip { {{ .Incus.BridgeSubnet }}, {{ .Incus.TunnelSlots }} } drop
        ether type ip ip saddr . iifname @owned4 accept
        ether type ip ip saddr { {{ .Incus.BridgeSubnet }}, {{ .Incus.TunnelSlots }} } drop
        ether type ip ip saddr 0.0.0.0 ip daddr 255.255.255.255 udp dport 67 accept
{{- range .Incus.Guests }}{{ if .SlotNet }}
        iifname "{{ .Port }}" ether type ip ip daddr {{ .SlotNet }} accept
{{- end }}{{ end }}
        ether type ip drop
    }

    # The two hooks that a guest's frame meets: input for the host, and forward for another port.
    # Incus's own tables hold priority -200, so this one runs first.
    chain input {
        type filter hook input priority -300; policy accept;
        jump from_guest
    }

    chain forward {
        type filter hook forward priority -300; policy accept;
        jump from_guest
    }
}

# The way out by a guest's tunnel interface: only what came in by that guest's port.
table ip ws_guest_out {
    chain forward {
        type filter hook forward priority -300; policy accept;
{{- range .Incus.Guests }}{{ if .Link }}
        oifname "{{ .Link }}" meta mark != {{ .Mark }} drop
{{- end }}{{ end }}
    }
}
