# cable's units: the Mac's cable on the port that WS_CABLE_PORT names, at WS_CABLE_ADDRESS. README.md
# says why each check stands. Without the port the file goes; a machine without the interface, as a
# cloud VM, keeps its netplan files as they are.

# Refuses a port that is an uplink, and a networkd that does not run, before the file changes.
[guard.cable]
command = ["{{ self }}", "ubuntu", "host", "cable", "check"]
when = { interface = "{{ .Cable.Port }}" }

# The cable's netplan file. Its check merges it with netplan's other files in a scratch root, so a
# file that would hand the port to another entry never goes live.
[file.cable]
after = "guard/cable"
path = "/etc/netplan/60-cable.yaml"
{{ if .Cable.Port -}}
mode = 0o600
template = "60-cable.yaml.tmpl"
check = ["{{ self }}", "ubuntu", "host", "cable", "check", "{}"]
when = { interface = "{{ .Cable.Port }}" }
{{- else -}}
absent = true
{{- end }}

# netplan generate and networkd's reload, where the cable's file changed since the last reload. A
# failed reload stays due, and another netplan file's change never makes it due.
[state.cable-reload]
after = "file/cable"
run = { user = "root", command = ["{{ self }}", "ubuntu", "host", "cable", "reload"], check = ["{{ self }}", "ubuntu", "host", "cable", "reload", "--check"] }
