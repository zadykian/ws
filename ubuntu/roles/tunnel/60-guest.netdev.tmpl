# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# {{ .Link }}, the tunnel's end on this host for the guest {{ .Guest }}. networkd reads the private key from the
# file below, made here. Each peer's public key is that of {{ .PeersDir }}/NAME.pub, and a peer
# without that file is left out. The host never speaks first: it answers each peer at the address
# its last packet came from.
[NetDev]
Name={{ .Link }}
Kind=wireguard

[WireGuard]
PrivateKeyFile={{ .KeyFile }}
ListenPort={{ .Port }}
{{- range .Peers }}

# {{ .Name }}
[WireGuardPeer]
PublicKey={{ .Key }}
AllowedIPs={{ .Address }}/32
{{- end }}
