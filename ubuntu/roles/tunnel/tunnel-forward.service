# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# Sends what arrives on each guest's interface to that guest, by a rule and routes. They live in
# the kernel alone, so a reboot loses them, and the main table would route a peer's packets to any
# guest. Incus flushes its bridge as it starts, which takes each guest's route, so each start of
# Incus's runs this again, by its socket too. The bridge comes with Incus, so this retries until
# the bridge is up.
[Unit]
Description=Send each guest's tunnel to its guest
Documentation=https://github.com/zadykian/ws/blob/main/ubuntu/roles/tunnel/README.md#the-forward
After=incus.service systemd-networkd.service
Wants=incus.service
PartOf=incus.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ws ubuntu host tunnel guests forward
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target incus.service
