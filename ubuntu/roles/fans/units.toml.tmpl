# fans' units, on the board whose maker DMI names WS_FANS_BOARD_VENDOR: README.md says why. On
# another board, or with the value empty, each is off.

# DKMS, and the kernel's headers that it builds the driver against.
[packages.fans]
template = "files/packages.tmpl"
when = { board_vendor = "{{ .Fans.BoardVendor }}" }

# The driver nct6687, which DKMS builds for the board's chip. Its repository tags no releases: the
# pin is a commit and the SHA-256 of GitHub's tarball of it. DKMS's version is the commit, short,
# as the driver's own dkms.conf has a fixed 1. Linux's own nct6683 holds the chip, and goes first.
[dkms.fans]
module = "nct6687d"
version = "7e3d7b36c55f"
url = "https://github.com/Fred78290/nct6687d/archive/7e3d7b36c55f06ab5bb2077bc85329f592996b2a.tar.gz"
sha256 = "d45306407920334b7a3e11c6a89c0527cbd5557b4efac343b96de7b4bffa850a"
strip = 1
conf = "files/dkms.conf"
load = "nct6687"
unload = ["nct6683"]
hint = "The board's own curves drive its fans: ubuntu/roles/fans/README.md#secure-boot says how to enroll the key."
after = "packages/fans"
when = { board_vendor = "{{ .Fans.BoardVendor }}" }

# ws-fans, with the files that one restart covers. It runs /usr/local/bin/ws, so a new ws reads as
# drift: the running process's binary is then the deleted one.
[service.fans]
unit = "ws-fans.service"
enabled = true
run = "running"
in_force = ["sh", "-c", "readlink /proc/$(systemctl show -P MainPID ws-fans.service)/exe"]
loads = ["readlink", "-f", "/usr/local/bin/ws"]
when = { board_vendor = "{{ .Fans.BoardVendor }}" }

[[service.fans.file]]
path = "/etc/modprobe.d/ws-fans.conf"
source = "files/modprobe.conf"

[[service.fans.file]]
path = "/etc/modules-load.d/ws-fans.conf"
source = "files/modules-load.conf"

# The daemon's own loader checks the config as the unit plans, so a refused one replaces nothing.
[[service.fans.file]]
path = "/etc/ws/fans.json"
template = "files/fans.json.tmpl"

[[service.fans.file]]
path = "/etc/systemd/system/ws-fans.service"
source = "files/ws-fans.service"
