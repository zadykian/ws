# nvidia's units. The driver installs where a PCI display device is NVIDIA's: README.md says why.
# The branch 595-server is named in packages.tmpl, archive.tmpl and the reboot's package.

# apt finds each name of the branch, on a machine without the GPU, so that CI fails where the
# archive drops one. The GPU's machine installs its own flavor's names whatever the archive holds of
# the others, so the check never blocks its driver.
[packages.nvidia-archive]
template = "archive.tmpl"
simulate = true
when = { gpu_vendor = "!0x10de" }

[packages.nvidia]
template = "packages.tmpl"
when = { gpu_vendor = "0x10de" }

# A new driver loads at the next boot: until then, this says a reboot is due.
[state.nvidia-reboot]
after = "packages/nvidia"
when = { gpu_vendor = "0x10de" }

[state.nvidia-reboot.reboot]
module = "nvidia"
package = "nvidia-utils-595-server"
hint = "Until then, ws-fans reads no GPU."
