# The docker role's units, a Go template over /etc/ws/values.yml. mise adds Docker's repository and
# packages first. These set up the daemon and its resolver, each behind the one before.
{{- $bridge := printf "%s/%d" .Docker.BridgeIP .Docker.BridgePrefixLength }}

# Docker avoids no route but the main table's on-link ones, so a VPN's route into its networks is
# refused before daemon.json takes the pool. The routes are those of the moment: a VPN that is
# down has none.
[state.docker-routes]
routes = { pool = "{{ .Docker.AddressPool }}", net = "{{ $bridge }}", dev = "docker0", hint = "Set WS_DOCKER_ADDRESS_POOL and WS_DOCKER_BRIDGE_IP clear of them. A moved pool serves the networks created afterwards, as by docker compose down and up. docker0 takes a moved bridge as Docker starts with no container running, as after a reboot" }

# Containers resolve names through the host's resolver, on the default bridge's address.
[file.docker-resolved]
path = "/etc/systemd/resolved.conf.d/docker.conf"
template = "files/resolved.conf.tmpl"
service = "systemd-resolved.service"
after = "state/docker-routes"

# ufw lets Docker's networks reach that resolver through their bridges, whatever their subnets. A
# host's alone: a guest holds no filter.
[state.docker-dns]
after = "file/docker-resolved"
when = { side = "host" }

[state.docker-dns.ufw]
comment = "DNS from containers"
rules = [
  { action = "allow", proto = "any", to = "{{ .Docker.BridgeIP }}", to_port = "53", from = "0.0.0.0/0", from_port = "any", dir = "in", interface = "docker0" },
  { action = "allow", proto = "any", to = "{{ .Docker.BridgeIP }}", to_port = "53", from = "0.0.0.0/0", from_port = "any", dir = "in", interface = "br-+" },
]

# The limits are over dockerd and its containers together: the values', or half the RAM and the
# CPUs. docker.service's drop-in puts dockerd in the slice, so a change here waits for its restart.
[file.docker-slice]
path = "/etc/systemd/system/docker.slice"
template = "files/docker.slice.tmpl"
after = "{{ if eq side "host" }}state/docker-dns{{ else }}file/docker-resolved{{ end }}"

# One restart for both files, which live-restore carries the running containers past. dockerd
# checks daemon.json before it replaces the live one.
[service.docker]
unit = "docker.service"
enabled = true
run = "running"
after = "file/docker-slice"

[[service.docker.file]]
path = "/etc/systemd/system/docker.service.d/override.conf"
source = "files/override.conf"

[[service.docker.file]]
path = "/etc/docker/daemon.json"
template = "files/daemon.json.tmpl"
check = ["dockerd", "--validate", "--config-file", "{}"]

# docker0 takes a moved address only as dockerd starts with no container running.
[state.docker-bridge]
addr = { iface = "docker0", want = "{{ $bridge }}", hint = "Docker moves it only as it starts with no container running, and until then lookups to a moved address get no answers. Reboot, or stop every container and restart Docker, then run the bootstrap again, as the server's runbook writes it" }
after = "service/docker"

# A first run starts Docker with forwarding off, so Docker turns it on and sets the FORWARD policy
# to drop, which ip-forward-no-drop leaves alone from then on. With no ufw to route what wg0 sends
# to ikeward0, the policy goes back to accept, with no reboot. A guest's alone: a host's ufw drops
# what it routes unless a rule allows it.
[state.docker-forward-policy]
after = "service/docker"
when = { side = "guest" }
run = { user = "root", command = ["iptables", "-w", "-P", "FORWARD", "ACCEPT"], check = ["sh", "-c", "iptables -w -S FORWARD | grep -qx -- '-P FORWARD ACCEPT'"] }
