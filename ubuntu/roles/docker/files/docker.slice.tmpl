[Unit]
Description=Docker's daemon and its containers

[Slice]
MemoryMax={{ or .Docker.MemoryMax (printf "%dM" (div mem_mib 2)) }}
CPUQuota={{ or .Docker.CPUQuota (printf "%d%%" (mul cpus 50)) }}
MemorySwapMax={{ .Docker.MemorySwapMax }}
