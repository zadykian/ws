---
profile: production
# Warnings fail too.
strict: true
# The collections come from requirements.yml, at its pins, not from what ansible-lint fetches.
offline: true
# Plans, worktrees and the tools' cache are local and untracked. SigNoz's compose files are
# foundryctl's, in its style: CI forges them again instead.
exclude_paths:
  - .cache/
  - .claude/
  - .git/
  - roles/signoz/files/deployment/
