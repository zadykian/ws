#!/bin/sh
# Points a checkout's pin of ws at this tree's build, served on loopback in the release's place.
# CI's server job and a trial of a role run it so:
#
#   .tools/serve-build CHECKOUT DIR [OS ARCH]
#   DIR/serve-releases DIR 8765 [PORT_FILE] &
#
# The tree pins a release, which may lack what the tree's specs need. So this builds ws
# for OS and ARCH, linux amd64 by default, as the version that CHECKOUT/mise.toml pins. ws goes
# into DIR/download/vVERSION/, and serve-releases into DIR, both by .tools/build. Then it writes
# CHECKOUT/mise.local.toml, ws's whole entry with its URL on port 8765. CHECKOUT/mise.local.lock
# holds the build's SHA-256 under mise's name of the platform. mise loads them over mise.toml and
# mise.lock, and git ignores them. The caller serves DIR, on that port, as the URL names it. The
# Mac's job passes darwin arm64. Run it from anywhere.

set -eu

port=8765

# die prints a message of the script's and exits with status 1.
die() {
    printf '.tools/serve-build: %s\n' "$*" >&2
    exit 1
}

# pinned prints the version of ws's entry in the mise.toml $1.
pinned() {
    awk '/^\[/ { entry = ($0 == "[tools.\"http:ws\"]") }
        entry && $1 == "version" { gsub(/"/, "", $3); print $3; exit }' "$1"
}

# platform prints mise's name of the platform of OS $1 and ARCH $2, as mise.lock keys it.
platform() {
    case $1/$2 in
    linux/amd64) echo linux-x64 ;;
    linux/arm64) echo linux-arm64 ;;
    darwin/arm64) echo macos-arm64 ;;
    *) die "no platform of mise's for $1 $2" ;;
    esac
}

# sha256 prints the SHA-256 of the file $1: macOS has shasum where Linux has sha256sum.
sha256() {
    if command -v sha256sum >/dev/null; then
        sha256sum <"$1" | awk '{ print $1 }'
    else
        shasum -a 256 <"$1" | awk '{ print $1 }'
    fi
}

main() {
    [ $# -eq 2 ] || [ $# -eq 4 ] || die "usage: .tools/serve-build CHECKOUT DIR [OS ARCH]"
    os=${3:-linux}
    arch=${4:-amd64}
    target=$(platform "$os" "$arch")
    [ -f "$1/mise.toml" ] || die "$1 holds no mise.toml"
    checkout=$(cd "$1" && pwd)
    mkdir -p "$2"
    dir=$(cd "$2" && pwd)
    tools=$(cd "$(dirname "$0")" && pwd)
    version=$(pinned "$checkout/mise.toml")
    case $version in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) die "$checkout/mise.toml pins no version of ws: '$version'" ;;
    esac
    file=download/v$version/ws-$os-$arch
    sh "$tools/build" "$os" "$arch" "$dir/$file"
    sh "$tools/build" "$os" "$arch" "$dir/serve-releases" ./.tools/serve-releases
    sum=$(sha256 "$dir/$file")
    cat >"$checkout/mise.local.toml" <<TOML
# ws's build of a tree, which .tools/serve-build serves in the release's place: never committed.
[tools."http:ws"]
version = "$version"
bin = "ws"
url = "http://127.0.0.1:$port/download/v{{ version }}/ws-$os-$arch"
TOML
    cat >"$checkout/mise.local.lock" <<TOML
lockfile_version = 4

[[tools."http:ws"]]
version = "$version"
backend = "http:ws"
specifiers = ["$version"]

[tools."http:ws"."platforms.$target"]
checksum = "sha256:$sum"
url = "http://127.0.0.1:$port/$file"
TOML
}

main "$@"
