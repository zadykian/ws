#!/bin/sh
# ws-tunnel keeps the Mac's WireGuard tunnel to ws up, and points it at the fastest path to ws that
# answers: the cable, the home LAN, then the internet through the router. launchd runs it as root,
# from /Library/LaunchDaemons/com.github.zadykian.ws-tunnel.plist, which mac/setup.sh installs with
# root's copies of this script, of its functions in tunnel-conf.sh and tunnel-paths.sh, and of wg
# and wireguard-go in /usr/local/libexec/ws-tunnel.
#
#   ws-tunnel [run]    keeps the tunnel up until SIGTERM; SIGHUP has it read its settings again
#   ws-tunnel status   prints the path in use, the latest handshake and the bytes moved
#
# It reads /etc/ws-tunnel, which only root reads: private.key, the Mac's key; tunnel.conf, the
# KEY=value lines setup.sh copies from mac.conf; and routes.d, whose files hold a network a line
# that it routes into the tunnel too. It logs a line for each switch and failure to its standard
# output, launchd's log file, which it starts anew past 1 MiB.
#
# The tunnel runs on wireguard-go, as wg-quick does on macOS, with wg-quick's steps taken here:
# its utun gets 10.99.0.2 and a route to ws's 10.99.0.1, and the peer, ws, gets the endpoint of
# the path in use. A switch removes the peer and adds it again, so that wireguard-go handshakes
# at once, and holds only where that handshake completes within 5 s, WireGuard's own retry time.
#
# shellcheck source-path=SCRIPTDIR

set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 022
# launchd starts the daemon with each signal's default action, under which a SIGHUP would end it.
# So the traps come first, and a SIGHUP before the loop runs leaves reload set for its first pass.
reload=0
trap 'reload=1' HUP
trap 'exit 0' TERM INT

bin=/usr/local/libexec/ws-tunnel
etc=/etc/ws-tunnel
sockets=/var/run/wireguard
name_file=$sockets/ws-tunnel.name
state_file=/var/run/ws-tunnel.state
fifo=/var/run/ws-tunnel.fifo
log=/var/log/ws-tunnel.log
# The tunnel's two ends, its subnet, and the cable's subnet and ws's end of it.
server=10.99.0.1
address=10.99.0.2
tunnel_net=10.99.0.0/24
cable_net=10.77.0.0/30
cable_server=10.77.0.1
keepalive=25
change=com.apple.system.config.network_change

# wg runs root's copy of wg, as launchd's PATH has no Homebrew.
wg() {
    "$bin/wg" "$@"
}

# say logs a line, with the time.
say() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# trim_log starts the log anew past 1 MiB. launchd opens it to append, so the next line goes at
# its new end.
trim_log() {
    if [ -f "$log" ] && [ "$(wc -c <"$log")" -gt 1048576 ]; then
        : >"$log"
        say "started the log anew past 1 MiB"
    fi
}

# ticker writes a tick in 10 s, or hup at once where the HUP trap ends its sleep. A ticker on a
# fixed beat would queue ticks behind tiers that take longer, up to 5 s a path, and fill the pipe in
# time.
ticker() {
    if sleep 10; then
        echo tick
    else
        echo hup
    fi
}

# next_tick takes the reloads that HUPs left, then starts a ticker that writes to the events' fd 4.
# The daemon runs it as the first tiers end, and after a tick's work or a hup, so that each tick
# comes 10 s after the work ends. The ticker's stderr goes to /dev/null, as its shell would report
# there, in launchd's log, each sleep that the trap ends.
next_tick() {
    while [ "$reload" = 1 ]; do
        reload
    done
    ticker 3<&- 2>/dev/null >&4 &
    ticker_pid=$!
}

# The rest of the daemon's functions, from root's copies beside it: its settings in tunnel-conf.sh,
# and its paths to ws and its events in tunnel-paths.sh.
# shellcheck source=tunnel-conf.sh
. "$bin/tunnel-conf.sh"
# shellcheck source=tunnel-paths.sh
. "$bin/tunnel-paths.sh"

run() {
    [ "$(id -u)" = 0 ] || {
        echo "ws-tunnel: launchd runs it as root" >&2
        exit 1
    }
    trim_log
    read_conf || exit 1
    key=$new_key
    lan=$new_lan
    lan_server=$new_lan_server
    remote=$new_remote
    port=$new_port
    read_routes
    routes=$new_routes
    if [ -s "$name_file" ] && wg show "$(cat "$name_file")" public-key >/dev/null 2>&1; then
        say "already runs, on $(cat "$name_file")"
        exit 1
    fi

    wg_pid=
    ticker_pid=
    notify_pid=
    tun=
    seen=
    peer=
    ends=
    want=
    out=
    routed=
    unroutable=
    left_out=
    told=
    in_use=
    since=$(date +%s)
    misses=0
    mkdir -p "$sockets"
    rm -f "$name_file" "$state_file" "$fifo"
    trap stop EXIT

    # wireguard-go writes the name of the utun it gets to WG_TUN_NAME_FILE, then makes its socket.
    WG_TUN_NAME_FILE=$name_file "$bin/wireguard-go" -f utun &
    wg_pid=$!
    waited=0
    while :; do
        [ -s "$name_file" ] && tun=$(cat "$name_file") && [ -S "$sockets/$tun.sock" ] && break
        if [ "$waited" -ge 50 ] || ! kill -0 "$wg_pid" 2>/dev/null; then
            say "wireguard-go made no utun"
            exit 1
        fi
        sleep 0.1
        waited=$((waited + 1))
    done
    case $tun in
    utun[0-9] | utun[0-9][0-9] | utun[0-9][0-9][0-9]) ;;
    *)
        say "wireguard-go's interface, '$tun', is no utun"
        exit 1
        ;;
    esac
    if ! wg set "$tun" private-key "$etc/private.key" ||
        ! ifconfig "$tun" inet "$address/32" "$address" alias ||
        ! ifconfig "$tun" up ||
        ! route -q -n add -inet "$server/32" -interface "$tun" >/dev/null; then
        say "cannot set up $tun"
        exit 1
    fi
    say "started on $tun, $address"

    # The events: notifyutil's lines, a tick 10 s after the last tick or reload ended, and settle
    # 2 s after a network change, all on one pipe. The daemon reads it on fd 3 and keeps fd 4 open
    # to write it, so that it never ends; the helpers close fd 3. A helper opens the pipe to write
    # and ends, as the daemon's open to read waits for a writer.
    mkfifo -m 600 "$fifo" || exit 1
    : >"$fifo" &
    exec 3<"$fifo"
    exec 4>"$fifo"
    rm -f "$fifo"
    # bash 3.2, macOS's sh, goes on with a read that a trap cut short. So the trap ends the
    # ticker's sleep, and the ticker writes hup at once, which ends the read. A write of the
    # daemon's own, the pipe's only reader, would wait for good once the pipe is full. A helper of
    # the trap's would change $!, which the daemon reads as it starts its own. Until the first
    # ticker starts, the trap only sets reload.
    trap 'reload=1; [ -z "$ticker_pid" ] || pkill -P "$ticker_pid" 2>/dev/null' HUP
    watch_changes

    seen=$(addresses)
    tiers
    next_tick
    failed=0
    while :; do
        [ "$reload" = 0 ] || reload
        # A signal can cut a read short, and the loop then does the signal's work. As fd 4 keeps
        # the pipe open, nothing else ends a read, but in case it does, the daemon ends too.
        if ! read -r event <&3; then
            failed=$((failed + 1))
            if [ "$failed" -ge 10 ]; then
                say "cannot read its events"
                exit 1
            fi
            continue
        fi
        failed=0
        case $event in
        tick | hup)
            # A hup does no tick's work: next_tick takes its reload, before the loop's top under
            # bash 3.2, which reads on to the hup.
            [ "$event" = hup ] || tick
            next_tick
            ;;
        settle) settle ;;
        "$change") (sleep 2 && echo settle) 3<&- >&4 & ;;
        esac
    done
}

# status prints the state the daemon wrote and what wg reports of the peer.
status() {
    [ "$(id -u)" = 0 ] || {
        echo "ws-tunnel status: run it as root, with sudo" >&2
        exit 1
    }
    if [ ! -f "$state_file" ]; then
        echo "ws-tunnel isn't running; its log is $log"
        exit 1
    fi
    tier=
    endpoint=
    tun=
    since=
    routed=
    left_out=
    while IFS= read -r line; do
        value=${line#*=}
        case $line in
        tier=*) tier=$value ;;
        endpoint=*) endpoint=$value ;;
        interface=*) tun=$value ;;
        since=*) since=$value ;;
        routes=*) routed=$value ;;
        left_out=*) left_out=$value ;;
        esac
    done <"$state_file"
    read_conf || exit 1
    now=$(date +%s)
    case $tier in
    none) echo "tier: none, as no path to ws answers" ;;
    *) echo "tier: $tier" ;;
    esac
    echo "endpoint: ${endpoint:-none}"
    echo "interface: $tun"
    echo "since: $((now - since)) s ago"
    handshake=$(peer_field latest-handshakes "$new_key")
    if [ "${handshake:-0}" -gt 0 ]; then
        echo "latest handshake: $((now - handshake)) s ago"
    else
        echo "latest handshake: none"
    fi
    wg show "$tun" transfer 2>/dev/null | awk -v key="$new_key" '
        $1 == key { printf "transfer: %d B received, %d B sent\n", $2, $3 }'
    echo "routes: ${routed:-none}"
    [ -z "$left_out" ] || echo "left out, as they hold the endpoint: $left_out"
}

case ${1:-run} in
run) run ;;
status) status ;;
*)
    echo "usage: ws-tunnel [run | status]" >&2
    exit 2
    ;;
esac
