// Written by github.com/zadykian/ws, whose next run replaces any change made here.
// Zed's keys on the Mac: each key that Zed has an action for,
// and two keys of its own: Ctrl+Shift+R restarts a language server, Ctrl+Alt+Shift+Y reloads Zed.
// docs/mac-zed.md says which keys Zed lacks, and why.
[
  // The global keys. No context, so each beats Zed's defaults wherever focus is.
  {
    "unbind": {
      "ctrl-k": "editor::KillRingCut",
      "ctrl-m": "editor::MoveToEnclosingBracket",
      "ctrl-r": "projects::OpenRecent"
    },
    "bindings": {
      "ctrl-shift-s": "workspace::SaveAll",
      // Ctrl+Cmd+S replaces Zed's worktree security toggle
      "ctrl-cmd-s": "workspace::SaveAll",
      // Cmd+S is Zed's already
      "ctrl-s": "workspace::Save",
      "ctrl-alt->": "zed::IncreaseUiFontSize",
      "ctrl-alt-<": "zed::DecreaseUiFontSize",
      // Mouse button 5 is Zed's already
      "ctrl-=": "pane::GoForward",
      // Cmd+F is Zed's already
      "ctrl-f": "buffer_search::Deploy",
      // Shift+Cmd+F is Zed's already
      "ctrl-shift-f": "pane::DeploySearch",
      // Shift+Alt+/ alone: Shift+Ctrl+Down goes to the next highlighted usage
      "alt-?": "search::SelectNextMatch",
      "ctrl-q": "command_palette::Toggle",
      "ctrl-shift-t": "file_finder::Toggle",
      "ctrl-alt-shift-t": "project_symbols::Toggle",
      // Opens a folder; on a remote project, the server's
      "ctrl-o": "workspace::Open",
      // Replaces Zed's emacs-style backspace
      "ctrl-h": "buffer_search::DeployReplace",
      "ctrl-shift-h": ["pane::DeploySearch", { "replace_enabled": true }],
      // Files alone
      "ctrl-,": "file_finder::Toggle",
      "ctrl-alt-shift-e": "text_finder::Toggle",
      "ctrl-alt-2": "diagnostics::Deploy",
      "ctrl-alt-4": "diagnostics::Deploy",
      "ctrl-alt-v": "diagnostics::Deploy",
      "alt-shift-i": "diagnostics::DeployCurrentFile",
      "alt-f11": "diagnostics::Deploy",
      // Opens the project's diagnostics, where Alt+PgDn moves on
      "alt-shift-pagedown": "diagnostics::Deploy",
      "ctrl-shift-f12": "diagnostics::Deploy",
      "alt-shift-f2": "diagnostics::Deploy",
      "alt-shift-pageup": "diagnostics::Deploy",
      // Replaces Zed's Shift+Esc, which toggles zoom
      "shift-escape": "workspace::ToggleAllDocks",
      "alt-shift-l": "pane::RevealInProjectPanel",
      // Takes Shift+Alt+Right, macOS's select word
      "ctrl-end": "workspace::ActivateNextPane",
      "alt-shift-right": "workspace::ActivateNextPane",
      // Takes Alt+Right from Zed's word motion
      "ctrl-alt-pagedown": "pane::ActivateNextItem",
      "alt-right": "pane::ActivateNextItem",
      // Takes Alt+Left from Zed's word motion
      "ctrl-alt-pageup": "pane::ActivatePreviousItem",
      "alt-left": "pane::ActivatePreviousItem",
      "ctrl-home": "workspace::ActivatePreviousPane",
      "alt-shift-left": "workspace::ActivatePreviousPane",
      // By the dock, whichever its side
      "ctrl-alt-down": "workspace::DecreaseActiveDockSize",
      "ctrl-alt-left": "workspace::DecreaseActiveDockSize",
      "ctrl-alt-right": "workspace::IncreaseActiveDockSize",
      "ctrl-alt-up": "workspace::IncreaseActiveDockSize",
      "ctrl-alt-shift-r": "pane::SplitRight",
      // Ctrl+Cmd+F stays Zed's too
      "alt-shift-enter": "zed::ToggleFullScreen",
      "ctrl-shift-f4": "workspace::CloseActiveDock",
      // macOS's keyboard navigation may take Ctrl+F4
      "ctrl-f4": "pane::CloseActiveItem",
      "ctrl-\"": "workspace::ToggleZoom",
      "ctrl-alt-]": "workspace::ActivateNextWindow",
      "ctrl-alt-[": "workspace::ActivatePreviousWindow",
      "alt-f1": "pane::RevealInProjectPanel",
      // The agent panel; replaces Zed's F7, which steps over while stopped, as F10 steps over too
      "f7": "agent::ToggleFocus",
      "alt-7": "agent::ToggleFocus",
      "f5": "git_panel::ToggleFocus",
      "alt-5": "git_panel::ToggleFocus",
      "f1": "project_panel::ToggleFocus",
      "alt-1": "project_panel::ToggleFocus",
      "f2": "terminal_panel::Toggle",
      "alt-2": "terminal_panel::Toggle",
      // The log: Zed's git graph
      "f6": "git_graph::Open",
      "alt-6": "git_graph::Open",
      "ctrl-f1": "zed::OpenDocs",
      "ctrl-alt-k": "git::ToggleCommitEditor",
      "alt-x": "git::Branch",
      // The branch picker creates one
      "ctrl-alt-n": "git::Branch",
      "alt-z": "git::Fetch",
      // The active file
      "ctrl-alt-y": "workspace::ReloadActiveItem",
      // In the git graph
      "ctrl-alt-shift-c": "git_graph::CopyCommitSha",
      "alt-v": "git::Push",
      // A task named build, which tasks.json gives
      "ctrl-shift-b": ["task::Spawn", { "task_name": "build" }],
      "alt-shift-f9": "debugger::Start",
      // The last debug session; Ctrl+F5 is macOS's toolbar key
      "ctrl-f5": "debugger::Rerun",
      // A task named go generate
      "ctrl-alt-g": ["task::Spawn", { "task_name": "go generate" }],
      // Shift+Ctrl+P alone: a Mac has no Pause; global, as the editor's Shift+Ctrl+P would win
      "ctrl-shift-p": "debugger::Pause",
      "ctrl-shift-f5": "debugger::Continue",
      "ctrl-shift-f9": "debugger::ClearAllBreakpoints",
      // The last task
      "shift-f5": "task::Rerun",
      "alt-f5": "debugger::Stop",
      // The modal, on its Attach tab by hand
      "ctrl-alt-p": "debugger::Start",
      "alt-)": "zed::ResetUiFontSize",
      "ctrl-alt-shift-s": "zed::OpenProjectSettings",
      "ctrl-alt-s": "zed::OpenSettings",
      "ctrl-alt-shift-y": "workspace::Reload"
    }
  },
  // Editing, in every editor, the one-line ones too.
  {
    "context": "Editor",
    "bindings": {
      // Cmd+C is Zed's already
      "ctrl-c": "editor::Copy",
      // Cmd+X is Zed's already; Ctrl+X cuts in the editor too
      "ctrl-x": "editor::Cut",
      // Ctrl+V replaces Zed's emacs-style page down
      "ctrl-v": "editor::Paste",
      // Shift+Cmd+Z is Zed's; Cmd+Y stays Zed's: the agent's Allow once and Keep, and the git panel's stage and next
      "ctrl-y": "editor::Redo",
      "ctrl-shift-z": "editor::Redo",
      // Cmd+Z is Zed's already
      "ctrl-z": "editor::Undo",
      "ctrl-?": "editor::ToggleBlockComments",
      // Ctrl+K, Ctrl+U toggles rather than uncomments
      "ctrl-alt-/": "editor::ToggleComments",
      "ctrl-k c": "editor::ToggleComments",
      "ctrl-k ctrl-c": "editor::ToggleComments",
      "ctrl-k ctrl-/": "editor::ToggleComments",
      "ctrl-k ctrl-u": "editor::ToggleComments",
      // Mouse wheel left to Zed
      "ctrl-_": "zed::DecreaseBufferFontSize",
      "ctrl-+": "zed::IncreaseBufferFontSize",
      "ctrl-|": "zed::ResetBufferFontSize",
      "ctrl-delete": "editor::DeleteToNextWordEnd",
      "ctrl-backspace": "editor::DeleteToPreviousWordStart",
      // Replaces Zed's emacs-style delete
      "ctrl-d": "editor::DuplicateSelection",
      "ctrl-shift-j": "editor::JoinLines",
      "ctrl-alt-shift-v": "editor::Paste",
      "ctrl-shift-u": "editor::ToggleCase",
      // Ctrl+A replaces Zed's emacs-style line start
      "ctrl-a": "editor::SelectAll",
      // Replaces Zed's line duplicate up
      "alt-shift-up": "editor::AddSelectionAbove",
      // Replaces Zed's line duplicate down
      "alt-shift-down": "editor::AddSelectionBelow",
      "alt-+": "editor::SelectLargerSyntaxNode",
      "ctrl-w": "editor::SelectLargerSyntaxNode",
      "alt-_": "editor::SelectSmallerSyntaxNode",
      "ctrl-shift-w": "editor::SelectSmallerSyntaxNode",
      "alt-:": "editor::SelectAllMatches",
      "alt->": ["editor::SelectNext", { "replace_newest": false }],
      // Undoes the last selection change
      "alt-<": "editor::UndoSelection",
      "alt-shift-g": "editor::SplitSelectionIntoLines",
      // Replaces Zed's larger syntax node selection
      "ctrl-shift-right": "editor::SelectToNextWordEnd",
      // Replaces Zed's smaller syntax node selection
      "ctrl-shift-left": "editor::SelectToPreviousWordStart",
      "ctrl-m c": "editor::ScrollCursorCenter",
      "ctrl-m ctrl-c": "editor::ScrollCursorCenter",
      // macOS's Spaces take Ctrl+Right by default
      "ctrl-right": "editor::MoveToNextWordEnd",
      // macOS's Spaces take Ctrl+Left by default
      "ctrl-left": "editor::MoveToPreviousWordStart",
      // App windows takes Ctrl+Down by default
      "ctrl-down": "editor::LineDown",
      // Mission Control takes Ctrl+Up by default
      "ctrl-up": "editor::LineUp",
      "ctrl-shift-f3": "editor::FindPreviousMatch",
      // Ctrl+F3: F-keys need Fn or the setting
      "ctrl-f3": "editor::FindNextMatch",
      "ctrl-i": "editor::ToggleInlayHints"
    }
  },
  // Code, in the full editor alone, so that search bars and pickers keep their keys.
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-shift-enter": "editor::NewlineBelow",
      // Zed offers snippets among completions
      "ctrl-k x": "editor::ShowCompletions",
      "ctrl-k ctrl-x": "editor::ShowCompletions",
      "ctrl-shift-delete": "editor::UnwrapSyntaxNode",
      "ctrl-alt-}": "editor::SelectToEndOfLargerSyntaxNode",
      "ctrl-alt-{": "editor::SelectToStartOfLargerSyntaxNode",
      "alt-}": "editor::SelectEnclosingSymbol",
      "ctrl-{": "editor::SelectEnclosingSymbol",
      "alt-shift-space": "editor::ShowCompletions",
      "ctrl-j": "editor::ShowCompletions",
      "alt-/": "editor::ShowWordCompletions",
      "ctrl-shift-space": "editor::ShowSignatureHelp",
      "ctrl-alt-space": "editor::ShowCompletions",
      "ctrl-k t": "call_hierarchy::ShowIncomingCalls",
      "ctrl-k ctrl-t": "call_hierarchy::ShowIncomingCalls",
      "ctrl-alt-shift-c": "editor::CopyFileLocation",
      "alt-{": "editor::MoveToStartOfLargerSyntaxNode",
      "ctrl-]": "editor::MoveToEnclosingBracket",
      "shift-f1": "editor::OpenDocs",
      "shift-f12": "editor::FindAllReferences",
      "alt-d": "editor::GoToDefinition",
      "ctrl-alt-d": "editor::GoToImplementation",
      "ctrl-k n": "editor::GoToNextBookmark",
      "ctrl-k ctrl-n": "editor::GoToNextBookmark",
      "ctrl-shift-down": "editor::GoToNextDocumentHighlight",
      "ctrl-shift-up": "editor::GoToPreviousDocumentHighlight",
      "ctrl-k p": "editor::GoToPreviousBookmark",
      "ctrl-k ctrl-p": "editor::GoToPreviousBookmark",
      "alt-home": "editor::GoToImplementation",
      "ctrl-shift-f11": "editor::GoToTypeDefinition",
      "ctrl-shift-backspace": "editor::GoToPreviousChange",
      "ctrl-k i": "editor::Hover",
      "ctrl-k ctrl-i": "editor::Hover",
      "ctrl-shift-f1": "editor::Hover",
      "ctrl-[": ["action::Sequence", ["editor::SelectEnclosingSymbol", "editor::MoveLeft"]],
      "ctrl-alt-shift-f12": "editor::FindAllReferences",
      "ctrl-f11": "editor::ToggleBookmarkWithLabel",
      "alt-\\": "outline::Toggle",
      "ctrl-/": "assistant::InlineAssist",
      "ctrl-r s": "editor::ToggleCodeActions",
      "ctrl-r m": "editor::ToggleCodeActions",
      "ctrl-alt-shift-f": "editor::Format",
      "ctrl-shift-i": "editor::ToggleCodeActions",
      "ctrl-alt-c": "editor::ToggleCodeActions",
      "ctrl-t": "editor::ToggleCodeActions",
      "ctrl-alt-enter": "editor::Format",
      "ctrl-k f": "editor::Format",
      "ctrl-k ctrl-f": "editor::Format",
      "ctrl-k d": "editor::Format",
      "ctrl-k ctrl-d": "editor::Format",
      "ctrl-r r": "editor::Rename",
      "ctrl-e": "editor::Hover",
      "alt-enter": "editor::ToggleCodeActions",
      "shift-enter": "editor::ToggleCodeActions",
      "ctrl-enter": "editor::ToggleCodeActions",
      "ctrl-alt-shift-l": "editor::Format",
      "ctrl-m a": "editor::FoldAll",
      "ctrl-m ctrl-a": "editor::FoldAll",
      "ctrl-m s": "editor::Fold",
      "ctrl-m ctrl-s": "editor::Fold",
      "ctrl-m h": "editor::FoldSelectedRanges",
      "ctrl-m ctrl-h": "editor::FoldSelectedRanges",
      "ctrl-m u": "editor::FoldSelectedRanges",
      "ctrl-m ctrl-u": "editor::FoldSelectedRanges",
      "ctrl-m x": "editor::UnfoldAll",
      "ctrl-m ctrl-x": "editor::UnfoldAll",
      "ctrl-m m": "editor::ToggleFold",
      "ctrl-m ctrl-m": "editor::ToggleFold",
      "ctrl-m e": "editor::UnfoldLines",
      "ctrl-m ctrl-e": "editor::UnfoldLines",
      "ctrl-m o": "editor::FoldFunctionBodies",
      "ctrl-m ctrl-o": "editor::FoldFunctionBodies",
      "ctrl-alt--": "editor::FoldRecursive",
      "ctrl-* 1": "editor::FoldAtLevel_1",
      "ctrl-* 2": "editor::FoldAtLevel_2",
      "ctrl-* 3": "editor::FoldAtLevel_3",
      "ctrl-* 4": "editor::FoldAtLevel_4",
      "ctrl-* 5": "editor::FoldAtLevel_5",
      "ctrl-alt-+": "editor::UnfoldRecursive",
      "ctrl-alt-=": "editor::UnfoldRecursive",
      "alt-pagedown": "editor::GoToDiagnostic",
      "alt-pageup": "editor::GoToPreviousDiagnostic",
      "f13": "editor::OpenContextMenu",
      "f8": "editor::GoToHunk",
      "shift-f8": "editor::GoToPreviousHunk",
      "shift-f7": "editor::GoToPreviousHunk",
      "ctrl-alt-z": "git::Restore",
      "ctrl-alt-shift-n": "editor::GoToHunk",
      "ctrl-alt-shift-p": "editor::GoToPreviousHunk",
      "alt-f9": "editor::EditLogBreakpoint",
      "ctrl-alt-b": "editor::EditLogBreakpoint",
      "ctrl-u u": "task::Rerun",
      "ctrl-u ctrl-u": "task::Rerun",
      "ctrl-u r": "editor::SpawnNearestTask",
      "ctrl-u ctrl-r": "editor::SpawnNearestTask",
      "ctrl-u y": "task::Rerun",
      "ctrl-u ctrl-y": "task::Rerun",
      "ctrl-f9": "debugger::ToggleEnableBreakpoint",
      "ctrl-b": "editor::ToggleBreakpoint",
      "ctrl-n": "workspace::NewFile",
      "ctrl-shift-r": "editor::RestartLanguageServer"
    }
  },
  // The signature popup.
  {
    "context": "Editor && showing_signature_help",
    "bindings": {
      "ctrl-shift-p": "editor::SignatureHelpPrevious",
      "ctrl-down": "editor::SignatureHelpNext",
      "ctrl-up": "editor::SignatureHelpPrevious"
    }
  },
  // The project panel: the tree keys, and F1 hides it again.
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-+": "project_panel::ExpandAllEntries",
      "ctrl--": "project_panel::CollapseAllEntries",
      "ctrl-shift-d": "project_panel::DownloadFromRemote",
      "ctrl-shift-a": "project_panel::NewFile",
      "ctrl-n": "project_panel::NewFile",
      "f1": "workspace::CloseActiveDock",
      "alt-1": "workspace::CloseActiveDock",
      "ctrl-r r": "project_panel::Rename",
      "ctrl-c": "project_panel::Copy",
      "ctrl-x": "project_panel::Cut",
      "ctrl-v": "project_panel::Paste",
      "ctrl-z": "project_panel::Undo",
      "ctrl-y": "project_panel::Redo",
      "ctrl-shift-f": "project_panel::NewSearchInDirectory"
    }
  },
  // The git panel; F5 hides it again.
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-alt-a": "git::ToggleStaged",
      "ctrl-alt-p": "git_panel::ToggleTreeView",
      "ctrl-alt-z": "git::RestoreFile",
      "ctrl-shift-h": "git::StashAll",
      "ctrl-alt-u": "git::StashPop",
      "f5": "workspace::CloseActiveDock",
      "alt-5": "workspace::CloseActiveDock"
    }
  },
  // The commit message.
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      "alt-c": "git::Commit",
      "alt-a": "git::Amend"
    }
  },
  // A stopped debug session: the step keys, so Alt keys type otherwise.
  {
    "context": "Workspace && debugger_stopped",
    "bindings": {
      "alt-f": "debugger::EvaluateSelectedText",
      "ctrl-alt-r": "debugger::RunToCursor",
      "ctrl-alt-e": "debugger::StepInto",
      "ctrl-alt-w": "debugger::StepOver",
      "alt-r": "debugger::RunToCursor",
      "alt-e": "debugger::StepInto",
      "alt-q": "debugger::StepOut",
      "alt-w": "debugger::StepOver",
      "ctrl-alt-f8": "debugger::EvaluateSelectedText"
    }
  },
  // Esc goes back to the editor from a panel; the terminal keeps its own Esc.
  {
    "context": "Dock || OutlinePanel || ProjectPanel || GitPanel",
    "bindings": {
      "escape": "editor::ToggleFocus"
    }
  },
  // The terminal: a Ctrl or Alt key with a letter or sign, without Shift, reaches the shell. The
  // chords' first keys go to it straight, so that they never wait (zed#28423).
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-s": "workspace::Save",
      "ctrl-=": "pane::GoForward",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-q": "command_palette::Toggle",
      "ctrl-o": "workspace::Open",
      "ctrl-h": "buffer_search::DeployReplace",
      "ctrl-,": "file_finder::Toggle",
      "ctrl-alt-v": "diagnostics::Deploy",
      "ctrl-alt-]": "workspace::ActivateNextWindow",
      "ctrl-alt-[": "workspace::ActivatePreviousWindow",
      "ctrl-alt-k": "git::ToggleCommitEditor",
      "alt-x": "git::Branch",
      "ctrl-alt-n": "git::Branch",
      "alt-z": "git::Fetch",
      "ctrl-alt-y": "workspace::ReloadActiveItem",
      "alt-v": "git::Push",
      "ctrl-alt-g": ["task::Spawn", { "task_name": "go generate" }],
      "ctrl-alt-p": "debugger::Start",
      "ctrl-alt-s": "zed::OpenSettings",
      "alt-left": "pane::ActivatePreviousItem",
      "alt-right": "pane::ActivateNextItem"
    },
    "bindings": {
      "ctrl-v": "terminal::Paste",
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-m": ["terminal::SendKeystroke", "ctrl-m"],
      "ctrl-u": ["terminal::SendKeystroke", "ctrl-u"],
      "f2": "workspace::CloseActiveDock",
      "alt-2": "workspace::CloseActiveDock"
    }
  }
]
