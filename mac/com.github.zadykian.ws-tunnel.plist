<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The tunnel's LaunchDaemon, which mac/setup.sh copies to /Library/LaunchDaemons: launchd runs
  ws-tunnel as root from boot, before any login, starts it again 10 s after it exits, and appends
  its output to /var/log/ws-tunnel.log.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.zadykian.ws-tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/ws-tunnel/ws-tunnel</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/log/ws-tunnel.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ws-tunnel.log</string>
</dict>
</plist>
