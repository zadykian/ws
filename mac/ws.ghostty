# The Mac's Ghostty settings, which mac/setup.sh writes to ws.ghostty, beside Ghostty's config.
# Ghostty reads them after the config's own, so each wins over the config's value, and
# shell-integration-features replaces the config's whole list. Its ssh-terminfo installs Ghostty's
# terminfo on ws at the first ssh from Ghostty, so ws installs none itself.
shell-integration = zsh
shell-integration-features = title,ssh-env,ssh-terminfo
# clipboard-read and title-report stay at Ghostty's defaults, ask and off: with either on, a program
# in a pane, one on ws included, reads the Mac's clipboard or has text typed at the prompt.
clipboard-write = allow
window-step-resize = true
# Ghostty brings back its windows after every quit, which cld restore tabs builds on.
window-save-state = always
window-vsync = true
# New windows open 200 columns by 60 rows. Those that window-save-state brings back keep their size.
window-height = 60
window-width = 200
window-new-tab-position = end
theme = Starlight
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
macos-icon = retro
# Ghostty updates itself from its stable releases: setup.sh installs it only where it is missing.
auto-update = download
auto-update-channel = stable
