#!/bin/sh
# ws-agent runs ws's ssh agent, which holds the YubiKey's keys for ssh and git, with no PIN.
# launchd runs it as the user, from login on, through
# ~/Library/LaunchAgents/com.github.zadykian.ws-agent.plist, which mac/setup.sh installs with
# this script's copy, ~/.config/ws/ws-agent, and that of the PIN's askpass, ws-agent-pin.
#
# It starts Apple's ssh-agent at ~/.ssh/ws-agent.sock, as macOS's own agent takes no -P: its
# default providers, /usr/lib*/*,/usr/local/lib*/*, matched after realpath, refuse Homebrew's
# libykcs11, whose link leads into the Cellar. Then it has the agent hold the YubiKey's keys while
# it is in. It logs each change and failure to its standard output, launchd's log file,
# ~/Library/Logs/ws-agent.log, which it starts anew past 1 MiB. Where ssh-agent ends, or the
# provider's path in the Cellar changes, it exits, and launchd starts it again.
# WS_AGENT_SOCKET gives a run beside launchd's, as CI's or a probe by hand, a socket of its own,
# and WS_AGENT_PROVIDER another provider than /opt/homebrew/lib/libykcs11.dylib.

set -u
# Apple's ssh-agent and ssh-add, as a pair. Homebrew's openssh would be /opt/homebrew/bin.
bin=/usr/bin
socket=${WS_AGENT_SOCKET:-$HOME/.ssh/ws-agent.sock}
provider=${WS_AGENT_PROVIDER:-/opt/homebrew/lib/libykcs11.dylib}
log=$HOME/Library/Logs/ws-agent.log
pin=$(cd "$(dirname "$0")" && pwd -P)/ws-agent-pin
SSH_AUTH_SOCK=$socket
export SSH_AUTH_SOCK

# say logs a line, with the time.
say() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# trim_log starts the log anew past 1 MiB, in launchd's run alone, as one with WS_AGENT_SOCKET logs
# elsewhere. launchd opens it to append, so the next line goes at its new end.
trim_log() {
    if [ -z "${WS_AGENT_SOCKET-}" ] && [ -f "$log" ] && [ "$(wc -c <"$log")" -gt 1048576 ]; then
        : >"$log"
        say "started the log anew past 1 MiB"
    fi
}

# start starts ssh-agent at the socket, and waits up to 5 s for it. -P allows the provider at its
# path in the Cellar alone, set as library. A pattern of the Cellar's versions would outlive a brew
# upgrade, but the agent keys the provider by its old path, which ssh-add -e then misses. A socket
# that no agent answers, as a killed agent leaves, goes first. One that answers stops it.
start() {
    if [ ! -e "$provider" ] || ! library=$(realpath "$provider" 2>/dev/null); then
        say "$provider is missing: brew install yubico-piv-tool puts it there"
        exit 1
    fi
    if [ -e "$socket" ]; then
        "$bin/ssh-add" -l >/dev/null 2>&1
        if [ $? != 2 ]; then
            say "an agent answers at $socket already"
            exit 1
        fi
        rm -f "$socket"
    fi
    [ -d "${socket%/*}" ] || mkdir -m 700 "${socket%/*}"
    "$bin/ssh-agent" -D -a "$socket" -P "$library" >/dev/null &
    agent=$!
    waited=0
    until [ -S "$socket" ]; do
        if [ "$waited" -ge 50 ] || ! kill -0 "$agent" 2>/dev/null; then
            say "ssh-agent made no socket at $socket"
            exit 1
        fi
        sleep 0.1
        waited=$((waited + 1))
    done
    say "started ssh-agent, pid $agent, at $socket for $library"
}

# yubikeys prints the registry IDs of the USB devices of Yubico's vendor ID, 4176 (0x1050), on a
# line, split by blanks. ioreg -l lists each entry's properties below the line that names its ID.
yubikeys() {
    yk_usb=$(ioreg -p IOUSB -l -w 0) || return 1
    printf '%s\n' "$yk_usb" | awk '
        /\+-o / { id = match($0, /, id 0x[0-9a-f]+/) ? substr($0, RSTART + 5, RLENGTH - 5) : "" }
        /"idVendor" = 4176$/ && id != "" { ids = ids " " id; id = "" }
        END { print substr(ids, 2) }'
}

# load puts the YubiKey's keys in the agent, through the PIN's askpass, and sets loaded where it
# did. ssh-add -e goes first, as the agent refuses -s for a provider it has. It logs a failure
# where its words change alone, as each try of again's would repeat it.
load() {
    tries=$((tries + 1))
    "$bin/ssh-add" -e "$provider" >/dev/null 2>&1
    if out=$(SSH_ASKPASS=$pin SSH_ASKPASS_REQUIRE=force "$bin/ssh-add" -s "$provider" 2>&1 \
        </dev/null); then
        loaded=1
        failed=
        say "loaded the YubiKey's keys"
    elif [ "$out" != "$failed" ]; then
        failed=$out
        say "ssh-add -s $provider failed: $out"
    fi
}

# again loads the keys again where the agent lists none while a YubiKey is in: at each read of
# ioreg for a minute from the plug, or from the keys' loss, then at every sixth, 30 s apart.
again() {
    if [ "$loaded" = 1 ]; then
        say "the agent lists no key, as after ssh-add -D or a crash of ssh-pkcs11-helper"
        loaded=0
        tries=0
    fi
    lacked=$((lacked + 1))
    if [ "$tries" -lt 12 ] || [ $((lacked % 6)) = 0 ]; then
        load
    fi
}

# stop ends the watch's sleep, and ssh-agent, which removes its socket.
# shellcheck disable=SC2329 # the EXIT trap runs it
stop() {
    [ -z "$nap" ] || kill "$nap" 2>/dev/null
    [ -z "$agent" ] || { kill "$agent" && wait "$agent"; } 2>/dev/null
}

# watch loads the keys, whatever ioreg lists, as libykcs11 shows no YubiKey that is out. Then it
# reads the YubiKeys in every 5 s. Where their IDs change, as a replug changes one, ssh-add -e takes
# the keys out, as the agent lists a key until then. While one is in, and ssh-add -l, which reads
# the agent's list alone, with no card and no signature, lists no key, again loads them: a card may
# answer seconds after its plug, or once Yubico Authenticator lets it go. It sleeps in the
# background, as wait, unlike sleep, ends at once on a signal.
watch() {
    seen=$(yubikeys) || say "ioreg -p IOUSB failed"
    loaded=0
    tries=0
    lacked=0
    failed=
    load
    while kill -0 "$agent" 2>/dev/null; do
        sleep 5 &
        nap=$!
        wait "$nap"
        nap=
        if [ ! -e "$provider" ] || [ "$(realpath "$provider" 2>/dev/null)" != "$library" ]; then
            say "$provider no longer leads to $library, as after a brew upgrade"
            exit 1
        fi
        if ! now=$(yubikeys); then
            say "ioreg -p IOUSB failed"
        elif [ "$now" != "$seen" ]; then
            say "the YubiKeys in, by ioreg's IDs: ${now:-none}"
            if [ "$loaded" = 1 ]; then
                "$bin/ssh-add" -e "$provider" >/dev/null 2>&1 ||
                    say "ssh-add -e $provider failed"
                say "took out the keys"
            fi
            seen=$now
            loaded=0
            tries=0
            failed=
        fi
        [ -z "$seen" ] || "$bin/ssh-add" -l >/dev/null 2>&1 || again
    done
    agent=
    say "ssh-agent ended"
    exit 1
}

[ $# = 0 ] || {
    echo "usage: ws-agent" >&2
    exit 2
}
[ "$(id -u)" != 0 ] || {
    echo "ws-agent: launchd runs it as the user, not root" >&2
    exit 1
}
agent=
nap=
trap stop EXIT
trap 'exit 0' HUP INT TERM
trim_log
start
watch
