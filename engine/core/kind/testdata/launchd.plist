<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by github.com/zadykian/ws -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.zadykian.ws-tunnel.lab</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/ws</string>
		<string>macos</string>
		<string>tunnel</string>
		<string>run</string>
		<string>--server</string>
		<string>lab</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/log/ws-tunnel.lab.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ws-tunnel.lab.log</string>
</dict>
</plist>
