# The Mac's WireGuard key, root's at 0600 in /etc/ws/tunnel, and its public half in
# /etc/ws/tunnel.pub, readable by all. Root's ws makes the key where none is and never shows it. It
# waits on the frame's unit, which keeps /usr/local/bin/ws root's alone: the ws that root runs.
[state.tunnel-key]
after = "state/ws-binary"

[state.tunnel-key.run]
user = "root"
creates = ["/etc/ws/tunnel/private.key", "/etc/ws/tunnel.pub"]
command = ["/usr/local/bin/ws", "macos", "tunnel", "key"]

# What each keyed server's daemon reads: its directory, routes.d and tunnel.conf, root's and
# readable by all. A server gone from servers/ has its daemon booted out and its files
# removed.
[state.tunnel-conf]
after = "state/tunnel-key"

[state.tunnel-conf.run]
user = "{{ .User }}"
command = ["{{ self }}", "macos", "tunnel", "conf"]
check = ["{{ self }}", "macos", "tunnel", "conf", "--check"]

# A daemon for each server with WS_PUBLIC_KEY, which launchd runs as root from boot. A new key
# restarts each. A daemon skips a network that another server's routes.d holds, and counts the
# other servers' endpoints. So a change to any server's files has each read them again by SIGHUP.
# It waits on the networks, the last of the files it reads.
[launchd.tunnel]
after = "state/networks"
prefix = "com.github.zadykian.ws-tunnel."
program = "/usr/local/bin/ws"
{{- range .Servers }}{{ if .PublicKey }}

[[launchd.tunnel.daemon]]
name = "{{ .Name }}"
arguments = ["/usr/local/bin/ws", "macos", "tunnel", "run", "--server", "{{ .Name }}"]
log = "/var/log/ws-tunnel.{{ .Name }}.log"
restart_on = ["/etc/ws/tunnel.pub"]
reload_on = [
{{- range $.Servers }}{{ if .PublicKey }}
    "/etc/ws/tunnel/{{ .Name }}/tunnel.conf",
    "/etc/ws/tunnel/{{ .Name }}/routes.d",
{{- end }}{{ end }}
]
{{- end }}{{ end }}
