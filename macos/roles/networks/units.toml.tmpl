# Each keyed server's routes.d/values and its resolvers in /etc/resolver, root's and readable by
# all. ws macos networks writes them through sudo, and removes a resolver of ws's that no
# server names. It waits on the tunnel's files, which make routes.d. launchd's unit of the tunnel
# watches routes.d, so a change reaches the daemons by SIGHUP.
[state.networks]
after = "state/tunnel-conf"

[state.networks.run]
user = "{{ .User }}"
command = ["{{ self }}", "macos", "networks"]
check = ["{{ self }}", "macos", "networks", "--check"]
