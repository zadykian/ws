# The docker CLI's settings, written where none is. cliPluginsExtraDirs is where the formulae link
# buildx and compose, which the CLI finds nowhere else. credsStore keeps registry logins in the
# Keychain, by docker-credential-osxkeychain. The user's changes stay: the unit never reads the
# file after. A JSON file takes no comment, so README.md says why.
[file.docker-config]
path = "{{ .Home }}/.docker/config.json"
owner = "{{ .User }}"
mode = 0o600
source = "files/config.json"
seed = true
