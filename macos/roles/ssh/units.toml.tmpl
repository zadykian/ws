# ssh's units. /etc/ws/ssh_config holds a Host for each server, through the tunnel, and ~/.ssh/config
# includes it at its top. README.md says why each stands.

# ~/.ssh, the user's and 0700, where missing, as ssh-keygen and ssh make it.
[state.ssh-dir.run]
user = "{{ .User }}"
creates = ["{{ .Home }}/.ssh"]
command = ["mkdir", "-m", "700", "{{ .Home }}/.ssh"]

# seward's copy goes in /usr/local/bin, which /etc/paths puts on every shell's, root:wheel and 0755,
# as fnox's does, under a temporary name first. With no seward of mise's this unit alone fails. The
# check runs as the user.
[state.seward.run]
user = "root"
command = [
    "sh",
    "-c",
    "test -x \"$1\" && mkdir -p /usr/local/bin && install -o root -g wheel -m 0755 \"$1\" /usr/local/bin/.seward.new && mv -f /usr/local/bin/.seward.new /usr/local/bin/seward",
    "sh",
    "{{ .SSH.SewardFrom }}",
]
check = [
    "sh",
    "-c",
    "cmp -s \"$1\" /usr/local/bin/seward && [ \"$(stat -f %u:%g:%Lp /usr/local/bin/seward)\" = 0:0:755 ]",
    "sh",
    "{{ .SSH.SewardFrom }}",
]

# The login key and the signing key, made by seward as the user and never as root. A key that
# root's session made fails to sign in the user's. creates names each key and its .pub, so a lost
# .pub comes back: keygen writes it again. A .pub with no key fails keygen, which says to remove it.
# A virtual machine has no Secure Enclave, so its keys go in a file (facts .VM).
[state.ssh-auth-key]
after = "state/seward"

[state.ssh-auth-key.run]
user = "{{ .User }}"
creates = ["{{ .Home }}/.ssh/ws-auth", "{{ .Home }}/.ssh/ws-auth.pub"]
command = ["/usr/local/bin/seward", "keygen", "ws-auth"{{ if .VM }}, "--store", "file"{{ end }}]

[state.ssh-sign-key]
after = "state/seward"

[state.ssh-sign-key.run]
user = "{{ .User }}"
creates = ["{{ .Home }}/.ssh/ws-sign", "{{ .Home }}/.ssh/ws-sign.pub"]
command = ["/usr/local/bin/seward", "keygen", "ws-sign"{{ if .VM }}, "--store", "file"{{ end }}]

# The servers' hosts, root's and readable by all (facts.SSH), which offer the login key through
# seward's agent. The facts checked the text as ssh reads it whole, with ~/.ssh/config; ssh checks
# the new file alone once more before it goes in.
[file.ssh-config]
after = "state/ssh-auth-key"
path = "/etc/ws/ssh_config"
template = "files/ssh_config.tmpl"
check = ["ssh", "-G", "-F", "{}", "localhost"]

# The Include, first in ~/.ssh/config, which stays the user's: ssh takes a setting's first value,
# so the servers' hosts win over a Host * of the user's. has refuses an Include below a setting, and
# leaves the file untouched. The old file stays as PATH.TIME~, and a link there stops the unit.
[file.ssh-include]
after = "state/ssh-dir"
path = "{{ .Home }}/.ssh/config"
owner = "{{ .User }}"
mode = 0o600
line = "Include /etc/ws/ssh_config"
has = ["{{ self }}", "macos", "ssh", "included"]
