# The maintainer's keyboard layout, the six files of KeyboardLayout.bundle, as Ukelele wrote them.
# Each is root's and readable by all, copied byte for byte: the two InfoPlist.strings are UTF-16, as
# macOS reads them. There is no mark of ws's, as a layout takes none. The input sources that name
# the layout are preferences, which mise writes before these units.
[file.layout-info]
path = "/Library/Keyboard Layouts/KeyboardLayout.bundle/Contents/Info.plist"
source = "files/KeyboardLayout.bundle/Contents/Info.plist"

[file.layout-version]
path = "/Library/Keyboard Layouts/KeyboardLayout.bundle/Contents/version.plist"
source = "files/KeyboardLayout.bundle/Contents/version.plist"

[file.layout-eng]
path = "/Library/Keyboard Layouts/KeyboardLayout.bundle/Contents/Resources/ENG.keylayout"
source = "files/KeyboardLayout.bundle/Contents/Resources/ENG.keylayout"

[file.layout-rus]
path = "/Library/Keyboard Layouts/KeyboardLayout.bundle/Contents/Resources/RUS.keylayout"
source = "files/KeyboardLayout.bundle/Contents/Resources/RUS.keylayout"

[file.layout-en-strings]
path = "/Library/Keyboard Layouts/KeyboardLayout.bundle/Contents/Resources/en.lproj/InfoPlist.strings"
source = "files/KeyboardLayout.bundle/Contents/Resources/en.lproj/InfoPlist.strings"

[file.layout-ru-strings]
path = "/Library/Keyboard Layouts/KeyboardLayout.bundle/Contents/Resources/ru.lproj/InfoPlist.strings"
source = "files/KeyboardLayout.bundle/Contents/Resources/ru.lproj/InfoPlist.strings"
