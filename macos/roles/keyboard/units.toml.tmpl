# The files of the bundle ws, the maintainer's keyboard layout. Each is root's and readable by all,
# copied byte for byte, with no mark of ws's, as a layout takes none. The input sources that name
# the layout are preferences, which mise writes before these units.
[file.layout-info]
path = "/Library/Keyboard Layouts/ws.bundle/Contents/Info.plist"
source = "files/ws.bundle/Contents/Info.plist"

[file.layout-version]
path = "/Library/Keyboard Layouts/ws.bundle/Contents/version.plist"
source = "files/ws.bundle/Contents/version.plist"

[file.layout-eng]
path = "/Library/Keyboard Layouts/ws.bundle/Contents/Resources/ENG.keylayout"
source = "files/ws.bundle/Contents/Resources/ENG.keylayout"

[file.layout-rus]
path = "/Library/Keyboard Layouts/ws.bundle/Contents/Resources/RUS.keylayout"
source = "files/ws.bundle/Contents/Resources/RUS.keylayout"

[file.layout-eng-icon]
path = "/Library/Keyboard Layouts/ws.bundle/Contents/Resources/ENG.icns"
source = "files/ws.bundle/Contents/Resources/ENG.icns"

[file.layout-rus-icon]
path = "/Library/Keyboard Layouts/ws.bundle/Contents/Resources/RUS.icns"
source = "files/ws.bundle/Contents/Resources/RUS.icns"
