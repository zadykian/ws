# Written by github.com/zadykian/ws, whose next run replaces any change made here.
# ~/.zshrc sources this file. It sets up oh-my-zsh, paths and aliases (macos/roles/zsh/README.md).
# Then the hook turns off the modes that a dropped ssh leaves on (macos/roles/ghostty/README.md).

# oh-my-zsh, where mise has cloned it. Its own update is off, as it would move the checkout off its
# pin. zsh-syntax-highlighting must come last of the plugins.
if [[ -r $HOME/.oh-my-zsh/oh-my-zsh.sh ]]; then
    export ZSH=$HOME/.oh-my-zsh
    ZSH_THEME=robbyrussell
    zstyle ':omz:update' mode disabled
    plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
    source $ZSH/oh-my-zsh.sh
fi

# ~/.local/bin first, and once in a nest of shells. gpg-agent's pinentry asks on this terminal.
typeset -U path
path=($HOME/.local/bin $path)
export GPG_TTY=$(tty 2>/dev/null)
alias genpass='pwgen -s 24 1'

# seward's agent, where its socket exists: until the agent runs there is none, and the shell keeps
# the agent that macOS starts. ssh and git reach seward's agent by their own settings.
ws_agent=$HOME/.ssh/seward.sock
[[ -S $ws_agent ]] && export SSH_AUTH_SOCK=$ws_agent
unset ws_agent

# The reports of the mouse, focus and the colour scheme; modifyOtherKeys and kitty's flags; cursor
# keys and keypad; the cursor's style and visibility.
ws_modes=$'\e[?1000l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1015l\e[?1004l\e[?2031l'
ws_modes+=$'\e[>4m\e[<99u\e[=0;1u\e[?1l\e>\e[0 q\e[?25h'
# The alternate screen's reset restores the main screen's cursor even where that screen is on. So
# ESC 7 saves the spot first, as the saved cursor is the screen's own.
ws_screen=$'\e7\e[?1049l'

# The alternate screen's reset follows a drop alone: an exit of 255 from ssh, or from cld with
# --host, which becomes ssh. Its ESC 7 takes the slot of a cursor that a program saved. Kitty's
# flags are each screen's own, so the modes go on both sides of the reset.
ws_preexec() {
    ws_ssh=
    [[ $2 == ssh || $2 == 'ssh '* || $2 == 'cld '*' --host'* ]] && ws_ssh=1
}

ws_precmd() {
    (($? == 255)) && [[ -n $ws_ssh ]] && print -rn -- "$ws_modes$ws_screen"
    print -rn -- "$ws_modes"
    ws_ssh=
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec ws_preexec
add-zsh-hook precmd ws_precmd

# oh-my-zsh's hooks come before ours, so ours moves to the front, where $? is still the command's.
precmd_functions=(ws_precmd ${precmd_functions:#ws_precmd})
