# ws's zsh settings, and the hook that turns off, at each prompt, the modes that a dropped ssh
# leaves on (macos/roles/zsh/README.md). The file is root's and readable by all, replaced whole,
# and starts with ws's mark, so that ours refuses a file there that ws did not write.
[file.zsh-rc]
path = "/etc/ws/zshrc"
source = "files/zshrc"
ours = true

# The line that sources the file, last in ~/.zshrc, so that the hook's own prompt functions come
# after the user's. The old file stays as ~/.zshrc.TIME~, and a ~/.zshrc that is a link stops the
# unit.
[file.zsh-line]
path = "{{ .Home }}/.zshrc"
owner = "{{ .User }}"
line = "source /etc/ws/zshrc"
line_at = "end"
