# git's units. ~/.gitconfig includes ws's settings, in /etc/ws/gitconfig, at its top. The signing
# key, seward's, has a file that trusts it, and git's credential command runs gh, which mise installs for the
# tree. README.md says why each stands.

# ws's settings, root's and readable by all (facts.Git): git's identity, the signing key, and gh as
# GitHub's credential command.
[file.git-config]
path = "/etc/ws/gitconfig"
template = "files/gitconfig.tmpl"

# The include at the top of ~/.gitconfig, which stays the user's, so that its own settings win. has
# refuses an include below the file's own settings, or one that comes twice, and leaves the file
# untouched. The old file stays as PATH.TIME~, and a link there stops the unit.
[file.git-include]
after = "file/git-config"
path = "{{ .Home }}/.gitconfig"
owner = "{{ .User }}"
line = "[include]\n\tpath = /etc/ws/gitconfig"
has = ["{{ self }}", "macos", "git", "included"]

# git's gpg.ssh.program: ssh-keygen with seward's agent, which holds the signing key. A terminal and
# an IDE then sign alike, whatever agent the app that runs git has.
[file.git-keygen]
path = "/etc/ws/ssh-keygen"
mode = 0o755
template = "files/ssh-keygen.tmpl"

# The file that trusts the signing key for git's email, in git verify-commit, root's and 644. It
# reads the key's .pub once the user's unit has made it.
[file.git-signers]
after = "state/ssh-sign-key"
path = "/etc/ws/allowed_signers"
template = "files/allowed_signers.tmpl"

# gh, which mise installs for the tree alone, on no shell's PATH. Its copy goes in /usr/local/bin,
# which /etc/paths puts on every shell's, root:wheel and 0755, as the frame keeps ws's. The copy goes in
# under a temporary name. With no gh of mise's this unit alone fails. The check runs as the user.
[state.gh.run]
user = "root"
command = [
    "sh",
    "-c",
    "test -x \"$1\" && mkdir -p /usr/local/bin && install -o root -g wheel -m 0755 \"$1\" /usr/local/bin/.gh.new && mv -f /usr/local/bin/.gh.new /usr/local/bin/gh",
    "sh",
    "{{ .Git.GhFrom }}",
]
check = [
    "sh",
    "-c",
    "cmp -s \"$1\" /usr/local/bin/gh && [ \"$(stat -f %u:%g:%Lp /usr/local/bin/gh)\" = 0:0:755 ]",
    "sh",
    "{{ .Git.GhFrom }}",
]
