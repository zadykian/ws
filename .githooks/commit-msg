#!/bin/sh
# Refuses a commit message that holds a word of the local list, matched as the pre-commit hook
# matches it, where _ separates words as - does. It names the lines that matched, never the word.

set -eu

list=$HOME/.config/ws/forbidden-words
[ -f "$list" ] || exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' INT TERM
sed -e 'y/_/ /' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e '/^#/d' \
    "$list" >"$tmp/words"

# From a message written in the editor, git strips its comments, the lines starting with #, and
# the diff below the scissors line; those become blank lines here, so that the line numbers stay
# the message's. A message given with -m or -F keeps every line: git runs the hooks with
# GIT_EDITOR=: then (githooks(5)). grep -w counts _ as part of a word, so each _ becomes a space,
# in the message as in the words. tr and sed read bytes, in the C locale: in a UTF-8 one, macOS's
# tr and sed fail on bytes that are not UTF-8, and GNU sed's .* stops at one.
if [ "${GIT_EDITOR-}" = : ]; then
    LC_ALL=C tr _ ' ' <"$1" >"$tmp/message"
else
    LC_ALL=C sed -e '/^# -* >8 -*$/,$d' -e 's/^#.*//' -e 'y/_/ /' "$1" >"$tmp/message"
fi

rc=0
grep -aniwF -f "$tmp/words" "$tmp/message" >"$tmp/hits" || rc=$?
# An error of grep's refuses the commit too, rather than letting the message pass unchecked.
[ "$rc" -le 1 ] || exit "$rc"
if [ "$rc" = 0 ]; then
    echo 'commit-msg: a word of the local list is in these lines of the message:' >&2
    cut -d: -f1 "$tmp/hits" | sed 's/^/    line /' >&2
    exit 1
fi
