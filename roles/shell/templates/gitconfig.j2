# Written by github.com/zadykian/ws, whose next run replaces any change made here. Settings of
# this machine's own go in ~/.config/git/local, included below.
[user]
	name = {{ shell_git_name }}
	email = {{ shell_git_email }}
{% if shell_git_signing %}
# Each commit signed with the machine's SSH key, which the allowed signers file trusts for the
# email above. The public key's path, so that an agent holding the key signs too; otherwise
# ssh-keygen reads the private key beside it.
	signingkey = {{ ws_git_signing_key }}.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ shell_git_allowed_signers }}
[commit]
	gpgsign = true
{% endif %}
# GitHub CLI's credential helper, byte for byte as `gh auth setup-git` writes it, the space after
# the empty helper's = included, so that running that changes nothing here. The empty helper
# drops any set before it.
[credential "https://github.com"]
	helper = {{ "" }}
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = {{ "" }}
	helper = !/usr/bin/gh auth git-credential
{% if shell_git_credentials %}
# The tokens of shell_git_credentials, each URL's in a file of the role's. The helper hands it to
# git for get alone, so that store and erase leave the file as written. Of two sections whose URLs
# match, the last wins, so the URLs go in order, each after those it extends.
{% endif %}
{% for credential in shell_git_credentials | sort(attribute='url') %}
{% set file = '~/.config/git/tokens/' ~ shell_git_credential_files[credential.url] %}
[credential "{{ credential.url }}"]
	helper =
	helper = "!f() { test \"$1\" != get || cat {{ file }}; }; f"
{% endfor %}
# Last, so that its settings win. git skips it where the file is missing.
[include]
	path = ~/.config/git/local
