{
  "builder": {
    "gc": {
      "enabled": true,
      "policy": [
        {
          "all": true,
          "filter": [
            "until=2160h"
          ]
        },
        {
          "reservedSpace": "51GB",
          "maxUsedSpace": "401GB",
          "minFreeSpace": "101GB"
        },
        {
          "all": true,
          "reservedSpace": "51GB",
          "maxUsedSpace": "401GB",
          "minFreeSpace": "101GB"
        }
      ]
    }
  },
  "cgroup-parent": "docker.slice",
  "default-network-opts": {
    "bridge": {
      "com.docker.network.bridge.host_binding_ipv4": "127.0.0.1"
    }
  },
  "dns": [
    "10.0.2.3"
  ],
  "ip": "127.0.0.1",
  "log-driver": "json-file",
  "log-opts": {
    "max-file": "3",
    "max-size": "10m"
  }
}
