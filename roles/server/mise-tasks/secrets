#!/usr/bin/env bash
#MISE description="Fetch ws's secrets by the host key, and run the bootstrap under them"
#USAGE arg "[args]..." help="mise bootstrap's arguments, as plan --detailed-exitcode" var=#true

# Fetches the repository of ws's secrets by the host key. Then it runs mise's bootstrap with the env
# secrets, under the values that the same key decrypts. Its arguments go to the bootstrap whole,
# and its exit is the bootstrap's. Each refusal exits 1. The page is
# roles/server/ubuntu/secrets/README.md.
set -euo pipefail
# The task's own files are root's alone. The bootstrap gets the caller's umask back.
mask=$(umask)
umask 077

run_line='sudo env MISE_DATA_DIR=/usr/local/share/mise MISE_LOCKED=1 mise -C /opt/ws/roles/server run secrets'
add_hint="on the Mac, run ws client macos secrets add NAME, NAME the server's name there"

# die prints a message of the task's and exits 1, never a code of git's or fnox's own.
die() {
    printf 'secrets: %s\n' "$*" >&2
    exit 1
}

# WS_SECRETS_PREFIX stands for / in front of the host key and /var/lib/ws, for the tests alone.
prefix=${WS_SECRETS_PREFIX:-}
side=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
key=${prefix}/etc/ssh/ssh_host_ed25519_key
pin=$side/ubuntu/secrets/github_known_hosts
dir=$prefix/var/lib/ws/secrets

# The values, the clone and the host key are root's, and fnox runs from the lock in mise's data
# directory alone.
[ "$(id -u)" = 0 ] || die "run it as root: $run_line"
[ "${MISE_DATA_DIR:-}" = /usr/local/share/mise ] && [ "${MISE_LOCKED:-}" = 1 ] ||
    die "run it with the runbook's variables: $run_line"
repo=${WS_SECRETS_REPO:-}
[ -n "$repo" ] || die "mise.toml sets no WS_SECRETS_REPO"

# The profile is the hostname, so the Mac's commands must accept it too: one DNS label, and no
# label of a recipient's or fnox's own.
host=$(hostname)
case $host in
'' | -* | *- | *[!0123456789abcdefghijklmnopqrstuvwxyz-]* | nano | backup | local | default)
    die "the hostname '$host' names no profile: set a hostname of one label at ws"
    ;;
esac
[ "${#host}" -le 63 ] || die "the hostname '$host' names no profile: set a hostname of one label at ws"
[ -f "$key" ] || die "no host key $key"
[ -f "$pin" ] || die "no pinned key of GitHub's, $pin"
command -v fnox >/dev/null || die "no fnox: run the bootstrap first, as it installs fnox"

tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT

# git and ssh read nothing of root's own. No config, no agent and no key but the host's take part,
# and GitHub's pinned key alone proves the server.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_SSH
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
GIT_SSH_COMMAND="ssh -F /dev/null -i $(printf %q "$key") -o IdentitiesOnly=yes -o IdentityAgent=none"
GIT_SSH_COMMAND+=" -o BatchMode=yes -o UserKnownHostsFile=$(printf %q "$pin")"
GIT_SSH_COMMAND+=" -o GlobalKnownHostsFile=/dev/null -o StrictHostKeyChecking=yes -o UpdateHostKeys=no"
export GIT_SSH_COMMAND

# fetch runs git and prints its errors whole. A key that GitHub refuses is mended on the Mac.
fetch() {
    local err=$tmp/git.err status=0
    "$@" 2>"$err" || status=$?
    cat -- "$err" >&2
    [ "$status" != 0 ] || return 0
    if grep -qF 'Permission denied (publickey' "$err"; then
        die "$repo refuses the host key: $add_hint"
    fi
    if grep -qF 'non-fast-forward' "$err"; then
        refuse "has a main that origin no longer holds"
    fi
    die "cannot fetch $repo"
}

# refuse stops at a clone that differs from origin's main. Once the clone is gone, the next run
# clones the repository again.
refuse() {
    die "$dir $1: remove it, and the next run clones $repo again"
}

(umask "$mask" && mkdir -p -- "${dir%/*}")
if [ ! -e "$dir" ] && [ ! -L "$dir" ]; then
    rm -rf -- "$dir.tmp"
    fetch git clone -q --branch main --single-branch -- "$repo" "$dir.tmp"
    chmod 700 -- "$dir.tmp"
    mv -T -- "$dir.tmp" "$dir"
else
    # fnox loads every fnox file of the clone, an ignored fnox.local.toml too, so the clone holds
    # nothing that origin's main lacks.
    [ ! -L "$dir" ] && [ -d "$dir/.git" ] || refuse "is not a clone"
    chmod 700 -- "$dir"
    origin=$(git -C "$dir" config --get remote.origin.url) || origin=
    [ "$origin" = "$repo" ] || refuse "is a clone of another repository"
    fetch git -C "$dir" fetch --no-progress origin main:refs/remotes/origin/main
    branch=$(git -C "$dir" symbolic-ref -q HEAD) || branch=
    [ "$branch" = refs/heads/main ] || refuse "is not on main"
    changes=$(git -C "$dir" status --porcelain=v1 --untracked-files=all --ignored=matching)
    [ -z "$changes" ] || refuse "holds changes of its own"
    git -C "$dir" merge-base --is-ancestor HEAD refs/remotes/origin/main ||
        refuse "holds a commit of its own"
    git -C "$dir" merge -q --ff-only refs/remotes/origin/main
fi
printf 'secrets: %s at %s\n' "$repo" "$(git -C "$dir" rev-parse --short HEAD)"

[ -f "$dir/fnox.$host.toml" ] || die "$repo holds no profile of $host, fnox.$host.toml: $add_hint"

# fnox fails closed: a value it cannot decrypt stops the run, no config of root's loads, and no
# key but the host's decrypts. Its own failures exit 1, as the bootstrap's may, so a first exec
# tells a key that opens nothing from a failed bootstrap.
mkdir -- "$tmp/fnox"
unset FNOX_AGE_KEY FNOX_AGE_IDENTITY
export FNOX_AGE_KEY_FILE=$key FNOX_CONFIG_DIR=$tmp/fnox FNOX_DAEMON=off
# fnox passes its environment on, so the bootstrap's own git, as a clone of WS_GIT_CLONES, gets
# none of the fetch's settings and its host key.
unset GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM GIT_TERMINAL_PROMPT GIT_SSH_COMMAND
umask "$mask"
cd -- "$dir"
fnox -P "$host" --if-missing error exec -- true ||
    die "the host key opens no value of $host's: $add_hint"
status=0
fnox -P "$host" --if-missing error exec -- mise -C "$side" -E ws,secrets bootstrap "$@" || status=$?
exit "$status"
