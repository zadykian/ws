# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# Keeps Docker's containers off the Mac, before Docker starts, through docker-user.sh, which says
# how. Docker wants the unit rather than requires it. A unit it required would keep Docker down
# where the drops fail. It would also restart Docker at each restart of the unit, as a run makes.
[Unit]
Description=Keep Docker's containers off the Mac's tunnel and cable
Documentation=https://github.com/zadykian/ws/blob/main/roles/server/ubuntu/wireguard/README.md#the-firewall
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{.Script}} {{.Interfaces}}

[Install]
WantedBy=docker.service
