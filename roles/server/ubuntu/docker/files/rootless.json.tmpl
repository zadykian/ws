{{- /* The account's daemon.json, as Go's encoder wrote it. It has no bip or address pools, as its
bridges live in rootlesskit's namespace and meet no route of the host's. Nor has it live-restore,
which a rootless daemon takes and does not honour. cgroup-parent keeps the containers inside the
account's docker.slice, as without it they land beside the unit and outside its limits. Its dns is
slirp4netns's own resolver, which answers through the host's. The build cache's limits are as the
system daemon's. */ -}}
{{- $disk := fs_bytes "/var/lib/docker" "/var/lib" -}}
{{- $reserved := or .Docker.BuildCacheReservedSpace (printf "%dGB" (add (div (mul $disk 10) 107374182400) 1)) -}}
{{- $maxUsed := or .Docker.BuildCacheMaxUsedSpace (printf "%dGB" (add (div (mul $disk 80) 107374182400) 1)) -}}
{{- $minFree := or .Docker.BuildCacheMinFreeSpace (printf "%dGB" (add (div (mul $disk 20) 107374182400) 1)) -}}
{
  "builder": {
    "gc": {
      "enabled": true,
      "policy": [
{{- if gt .Docker.BuildCacheKeepDays 0 }}
        {
          "all": true,
          "filter": [
            {{ json (printf "until=%dh" (mul .Docker.BuildCacheKeepDays 24)) }}
          ]
        },
{{- end }}
        {
          "reservedSpace": {{ json $reserved }},
          "maxUsedSpace": {{ json $maxUsed }},
          "minFreeSpace": {{ json $minFree }}
        },
        {
          "all": true,
          "reservedSpace": {{ json $reserved }},
          "maxUsedSpace": {{ json $maxUsed }},
          "minFreeSpace": {{ json $minFree }}
        }
      ]
    }
  },
  "cgroup-parent": "docker.slice",
  "default-network-opts": {
    "bridge": {
      "com.docker.network.bridge.host_binding_ipv4": {{ json .Docker.PublishIP }}
    }
  },
  "dns": [
    "10.0.2.3"
  ],
  "ip": {{ json .Docker.PublishIP }},
  "log-driver": "json-file",
  "log-opts": {
    "max-file": {{ json (print .Docker.LogMaxFile) }},
    "max-size": {{ json .Docker.LogMaxSize }}
  }
}
