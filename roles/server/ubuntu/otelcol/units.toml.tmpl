# The collector's units, for a service that needs the .deb that a unit brings: node_exporter is
# mise's (mise.server.toml). The service owns the collector's four files, so that a change of any
# of them, or of two together, restarts it once.

# The package starts the collector with its own config, on every address: it stays off until the
# service below sets it up. It waits on signoz's sync, so that SigNoz keeps what the collector
# sends for its retention: a retention applies only to data that comes in after it. The files read
# the endpoint from /etc/ws/env, which mise's files step writes before any unit, in the same run.
[deb.otelcol]
package = "otelcol-contrib"
version = "0.162.0"
url = "https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v{version}/otelcol-contrib_{version}_linux_{arch}.deb"
sha256 = { amd64 = "0b2b37eeb83db8e19a5f9dfc60894d058c739384a226ac085e674561befaad44", arm64 = "b6163e6639989ac608ae2ba58b891128f2f31bba1b0af31a937ac5d0de7b0c23" }
stop = "otelcol-contrib.service"
after = "state/signoz-sync"

[service.otelcol]
unit = "otelcol-contrib.service"
enabled = true
run = "running"
after = "deb/otelcol"

[[service.otelcol.file]]
path = "/etc/systemd/system/otelcol-contrib.service.d/journal.conf"
source = "files/journal.conf"

[[service.otelcol.file]]
path = "/etc/systemd/system/otelcol-contrib.service.d/claude.conf"
source = "files/claude.conf"

# The remote collector's endpoint, from /etc/ws/env. The file is there where the variable is set.
# The check refuses a value that is no http(s)://HOST:PORT with a port from 1 to 65535. It refuses
# one that leads back to the collector's own receiver too, as claude's metrics would go round
# without end. The first pattern is the form, the second the loop.
[[service.otelcol.file]]
path = "/etc/otelcol-contrib/claude.env"
template = "files/claude.env.tmpl"
mode = 0o600
secret = true
absent_when_empty = true
check = [
    "sh",
    "-c",
    'grep -qxE "$1" "$3" && ! grep -qixE "$2" "$3"',
    "sh",
    'OTEL_CLAUDE_EXPORTER_OTLP_ENDPOINT=https?://([A-Za-z0-9._-]+|\[[0-9A-Fa-f:.]+\]):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])',
    'OTEL_CLAUDE_EXPORTER_OTLP_ENDPOINT=https?://(127\.0\.0\.1|0\.0\.0\.0|\[[0:]*\]|\[[0:]*:ffff:(127\.0\.0\.1|0\.0\.0\.0)\]|([^/]*\.)?localhost\.?):4317',
    "{}",
]

# The remote endpoint is a stand-in in the check, as its value is in the service's environment
# alone.
[[service.otelcol.file]]
path = "/etc/otelcol-contrib/config.yaml"
template = "files/config.yaml.tmpl"
check = [
    "env",
    "OTEL_CLAUDE_EXPORTER_OTLP_ENDPOINT=http://remote.invalid:4317",
    "/usr/bin/otelcol-contrib",
    "validate",
    "--config={}",
]

# systemctl returns before the receivers start. One that cannot start stops the collector, which
# then never answers.
[state.otelcol-health]
http = "http://127.0.0.1:13133/"
after = "service/otelcol"
