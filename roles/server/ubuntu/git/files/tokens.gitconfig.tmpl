# Written by github.com/zadykian/ws, whose next run replaces any change made here.
# A run with a secrets file writes it. /etc/ws/gitconfig includes it after gh's credential program
# (roles/server/ubuntu/git/README.md#git-credentials).
# The tokens of the secrets file's [git] table, each URL's in a file of the role's. The helper hands it to
# git for get alone, so that store and erase leave the file as written. Of two sections whose URLs
# match, the last wins, so the URLs go in order, each after those it extends.
{{ range .Sections -}}
[credential "{{ .URL }}"]
	helper =
	helper = "!f() { test \"$1\" != get || cat /etc/ws/tokens/{{ .File }}; }; f"
{{ if .Proactive -}}
[http "{{ .URL }}"]
	proactiveAuth = basic
{{ end -}}
{{ end -}}
