# Written by github.com/zadykian/ws, whose next run replaces any change made here. Settings of
# this machine's own go in ~/.gitconfig, which includes this file at its top.
{{ .Settings -}}
# The helpers of git's tokens for servers besides GitHub, in a file of the role's that a run
# without a secrets file leaves alone. After gh's helper, so that an entry for a path on
# GitHub wins below it. git skips it where the file is missing.
[include]
	path = /etc/ws/tokens.gitconfig
