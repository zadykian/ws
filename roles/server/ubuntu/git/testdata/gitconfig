# Written by github.com/zadykian/ws, whose next run replaces any change made here. Settings of
# this machine's own go in ~/.gitconfig, which includes this file at its top.
[user]
	name = "zadykiand"
	email = su@zadykian.dev
# Each commit and tag signed with the machine's SSH key, which the allowed signers file trusts for the
# email above. The public key's path, so that an agent holding the key signs too; otherwise
# ssh-keygen reads the private key beside it.
	signingkey = "/root/.ssh/id_ed25519_signing.pub"
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = "/etc/ws/allowed_signers"
[commit]
	gpgsign = true
[tag]
	gpgsign = true
# A fetch drops the remote-tracking branches that the remote deleted, a landed pull request's
# say, so that Zed's and lazygit's branch lists hold none.
[fetch]
	prune = true
# GitHub CLI's credential helper, byte for byte as `gh auth setup-git` writes it, the space after
# the empty helper's = included, so that running that changes nothing here. The empty helper
# drops any set before it.
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
# Each commit made here, by any tool, credits the maintainer by one trailer. A hook of git's config runs
# beside the repository's own hooks, ws's .githooks included. addIfDifferent adds the trailer once,
# so that --amend and a second run add none. --no-divider keeps a line of three dashes in the body
# from moving it above that line. A message that is empty gets none, so that git aborts the
# commit as it does without the hook. Where no editor opens, git gives the hook GIT_EDITOR=:, its
# cleanup is whitespace, which keeps comments, and emptiness is git stripspace alone. With an
# editor the scissors section, a line of git's comment string, a space, 24 dashes, >8 and 24 dashes,
# and then the comments are cut. The hook cannot see an explicit --cleanup or commit.cleanup.
# git runs the command as sh -c 'COMMAND "$@"' with the message's file, which the function f takes
# as $1. git rebase and git cherry-pick run no commit-msg hook, so a commit they rewrite keeps its
# message, and a reword of git rebase -i runs it. Git 2.54 or above reads the hook.
[hook "ws-co-author"]
	event = commit-msg
	command = "f() { if [ \"$GIT_EDITOR\" = : ]; then t=$(git stripspace <\"$1\"); else t=$(sed '/^[^[:space:]]* -\\{24\\} >8 -\\{24\\}$/,$d' \"$1\" | git stripspace --strip-comments); fi; if [ -n \"$t\" ]; then git interpret-trailers --in-place --no-divider --if-exists addIfDifferent --trailer 'Co-authored-by: zadykian <me@zadykian.dev>' \"$1\"; fi; }; f"
# A push from here sends no commit that lacks a good signature or the trailer above. ws's check
# reads the pushed refs on its standard input. A failing hook refuses the push, which --no-verify,
# a config that disables or replaces the hook and a push through GitHub's API skip.
[hook "ws-push"]
	event = pre-push
	command = /usr/local/bin/ws server git pre-push
# The credential programs of git's tokens for servers besides GitHub, in a file of the role's. It
# follows /etc/ws/git-tokens.toml. After gh's program, so that an entry for a path on GitHub wins
# below it. git skips it where the file is missing.
[include]
	path = /etc/ws/tokens.gitconfig
