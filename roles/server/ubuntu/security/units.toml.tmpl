# The security role's units, a Go template over /etc/ws/values.yml. mise installs the packages and
# sets up fail2ban and ufw first. The lockout guard comes before the unit that could close a login.
# sshd's waits on it, and a guard fails before a change, never after.
{{- $on := .Security.Outbound }}

# WS_USER must hold a key that sshd takes, in the account's own home, before SSH by key alone.
[guard.security-keys]
login_key = "{{ .User }}"
home = "{{ .Home }}"

# SSH by key alone. sshd -G parses the drop-in alone before it goes in place, as sshd -t needs a
# /run/sshd that exists only once ssh.service has started since boot. A refused drop-in leaves the
# live one. ssh reloads in this unit where the drop-in changed, so a later failure leaves no sshd
# that takes passwords. ssh.socket starts sshd at the first login; before that, the unit starts it.
[service.security-sshd]
unit = "ssh.service"
run = "running"
reload = true
after = "guard/security-keys"

[[service.security-sshd.file]]
path = "/etc/ssh/sshd_config.d/10-keys-only.conf"
template = "files/10-keys-only.conf.tmpl"
check = ["/usr/sbin/sshd", "-G", "-f", "{}"]

# The outbound table. On, the fill and its watchers go in first, then the table and its unit. So a
# run cut short, then a boot, finds the old table or the new one with what fills its sets. Off
# (WS_SECURITY_OUTBOUND: false), each service is gone: it stops and is disabled while its file
# still names its ExecStop, then its files go. The path unit stops first, as it starts the fill,
# then the timer, the fill and the table, and last a table that no stop removed.
[service.security-resolvers-fill]
unit = "security-resolvers.service"
run = "{{ if $on }}triggered{{ else }}stopped{{ end }}"
{{- if not $on }}
after = "service/security-resolvers-timer"
{{- end }}

[[service.security-resolvers-fill.file]]
path = "/usr/local/lib/ws/security/resolvers.sh"
{{- if $on }}
mode = 0o755
source = "files/resolvers.sh"
{{- else }}
absent = true
{{- end }}

[[service.security-resolvers-fill.file]]
path = "/etc/systemd/system/security-resolvers.service"
{{- if $on }}
source = "files/security-resolvers.service"
{{- else }}
absent = true

# The fill's record of what it set.
[[service.security-resolvers-fill.file]]
path = "/run/security-resolvers.conf"
absent = true
{{- end }}

# The path unit watches resolv.conf from before the table loads (WantedBy=sysinit.target).
[service.security-resolvers-path]
unit = "security-resolvers.path"
enabled = {{ $on }}
run = "{{ if $on }}running{{ else }}stopped{{ end }}"
{{- if $on }}
after = "service/security-resolvers-fill"
{{- end }}

[[service.security-resolvers-path.file]]
path = "/etc/systemd/system/security-resolvers.path"
{{- if $on }}
source = "files/security-resolvers.path"
{{- else }}
absent = true
{{- end }}

[service.security-resolvers-timer]
unit = "security-resolvers.timer"
enabled = {{ $on }}
run = "{{ if $on }}running{{ else }}stopped{{ end }}"
after = "service/security-resolvers-path"

[[service.security-resolvers-timer.file]]
path = "/etc/systemd/system/security-resolvers.timer"
{{- if $on }}
source = "files/security-resolvers.timer"
{{- else }}
absent = true
{{- end }}

# nft -c needs the kernel's netfilter, so it checks with systemd booted alone. The table in force is
# compared with the one the files load, in a network namespace of its own, as the unit loads it. A
# run cut short before the reload, or a table flushed by hand, reloads it. -s leaves out the
# counters' values. unshare needs CAP_SYS_ADMIN, which CI's container lacks, and the comparison
# runs with systemd booted alone.
[service.security-outbound]
unit = "security-outbound.service"
enabled = {{ $on }}
run = "{{ if $on }}running{{ else }}stopped{{ end }}"
reload = true
in_force = ["nft", "-s", "list", "table", "inet", "ws"]
loads = [
    "unshare",
    "--net",
    "sh",
    "-c",
    '"$1" "$2" && nft -s list table inet ws',
    "sh",
    "/usr/local/lib/ws/security/resolvers.sh",
    "/usr/local/lib/ws/security/outbound.nft",
]
after = "{{ if $on }}service/security-resolvers-timer{{ else }}service/security-resolvers-fill{{ end }}"

[[service.security-outbound.file]]
path = "/usr/local/lib/ws/security/outbound.nft"
{{- if $on }}
source = "files/outbound.nft"
check = ["/usr/sbin/nft", "-c", "-f", "{}"]
check_booted = true
{{- else }}
absent = true
{{- end }}

[[service.security-outbound.file]]
path = "/etc/systemd/system/security-outbound.service"
{{- if $on }}
source = "files/security-outbound.service"
{{- else }}
absent = true

[[service.security-outbound.file]]
path = "/usr/local/lib/ws/security"
absent = true
{{- end }}

# Off, a table that no stop removed, as one loaded by hand with nft -f, goes too. A failed list is
# no table. Without booted systemd it skips.
[state.security-outbound-off]
run = { user = "root", command = ["nft", "destroy", "table", "inet", "ws"], check = ["sh", "-c", "! nft list table inet ws >/dev/null 2>&1"] }
when = { set = "{{ if not $on }}yes{{ end }}" }
after = "service/security-outbound"
