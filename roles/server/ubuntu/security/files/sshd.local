# Written by github.com/zadykian/ws's security role; edit it there.
#
# The sshd jail, on the journal, enabled whatever Ubuntu's defaults-debian.conf says. That file
# still sets its ban action, nftables, and jail.conf its limit of 5 failed logins in 10 minutes.
# This file sets the ban at an hour.
[sshd]
enabled = true
backend = systemd
bantime = 1h
