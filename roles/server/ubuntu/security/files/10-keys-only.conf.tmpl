# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# SSH by key only. sshd keeps the first value it reads for each keyword. It reads this file before
# the lines of sshd_config and before a later drop-in, such as cloud-init's 50-cloud-init.conf,
# which may allow passwords.
PasswordAuthentication no
KbdInteractiveAuthentication no
{{- if .Root }}
# WS_USER is root, who logs in by key only.
PermitRootLogin prohibit-password
{{- else }}
# WS_USER logs in, and takes root by sudo with its password.
PermitRootLogin no
{{- end }}
