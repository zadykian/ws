# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# What ws and its containers start goes to the internet and ikeward0 alone. A new packet to a
# private, shared, link-local, multicast or broadcast range drops: these hold the LAN, the cable
# and wg0, none of them named. Replies pass, so ws still answers the Mac, over WireGuard too, as
# the Mac speaks first and keeps the flow alive.
#
# security-outbound.service loads it through resolvers.sh, one transaction that replaces this table
# and no other: nftables.conf would flush ufw's, Docker's, fail2ban's and ikeward's tables too. No
# rule holds a set of ranges, or of names with *. The kernel fills such a set after its rules take
# effect, and in a lab, packets to the LAN got past a reload. Each run loads the file in an empty
# network namespace too (outbound.yml), so a rule names a link by oifname or iifname, never by the
# index of oif or iif.
destroy table inet ws

table inet ws {
    # resolved's DNS servers, which resolvers.sh fills.
    set resolvers4 {
        type ipv4_addr
    }

    set resolvers6 {
        type ipv6_addr
    }

    chain output {
        type filter hook output priority filter; policy accept;
        ct state established,related accept
        # Loopback, the VPN, and Docker's bridges, whose packets the forward chain sees.
        oifname { "lo", "ikeward0", "docker0" } accept
        oifname "br-*" accept
        # networkd's DHCP and DHCPv6, by its user, as a raw socket could forge the ports. Its DHCP
        # messages but a renewal go out by AF_PACKET, which no hook sees.
        meta skuid "systemd-network" udp sport 68 udp dport 67 accept
        meta skuid "systemd-network" udp sport 546 udp dport 547 accept
        # IPv6 finds its router and neighbours, and joins groups, on each link.
        icmpv6 type {
            nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert,
            mld-listener-report, mld2-listener-report
        } accept
        # resolved's lookups for ws and its containers pass to its servers. private judges the rest.
        meta skuid "systemd-resolve" meta l4proto { tcp, udp } th dport 53 jump dns
        jump private
    }

    # Unfilled, the sets accept nothing: a lookup to a private server drops, to a public one passes.
    chain dns {
        ip daddr @resolvers4 accept
        ip6 daddr @resolvers6 accept
    }

    # Docker's containers. What comes in by another link, as wg0's way to ikeward0, is ufw's to
    # judge.
    chain forward {
        type filter hook forward priority filter; policy accept;
        ct state established,related accept
        iifname "docker0" jump containers
        iifname "br-*" jump containers
    }

    chain containers {
        oifname { "ikeward0", "docker0" } return
        oifname "br-*" return
        jump private
    }

    # A new packet to these drops. The rest is the internet, and passes.
    chain private {
        ip daddr 10.0.0.0/8 drop
        ip daddr 100.64.0.0/10 drop
        ip daddr 169.254.0.0/16 drop
        ip daddr 172.16.0.0/12 drop
        ip daddr 192.168.0.0/16 drop
        ip daddr 224.0.0.0/4 drop
        ip daddr 255.255.255.255 drop
        ip6 daddr fc00::/7 drop
        ip6 daddr fe80::/10 drop
        ip6 daddr ff00::/8 drop
        # A global address on a link, should the LAN gain an IPv6 prefix: the next hop is the
        # address itself, where a routed packet's is a link-local router.
        ip6 daddr != fe80::/10 rt ip6 nexthop != fe80::/10 drop
    }
}
