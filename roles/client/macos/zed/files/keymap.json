// Written by github.com/zadykian/ws, whose next run replaces any change made here.
// Zed's keys on the Mac: the Alt and F keys that Zed has an action for, and Shift twice for the
// command palette. The Cmd and Ctrl keys stay Zed's macOS defaults, but for Cmd+T, which opens a
// new terminal in place of Ctrl+~.
// The block of keys left out, at this file's end, says which keys Zed lacks, and why.
[
  // The global keys. No context, so each beats Zed's defaults wherever focus is.
  {
    "bindings": {
      "alt-?": "search::SelectNextMatch",
      "alt-shift-i": "diagnostics::DeployCurrentFile",
      "alt-f11": "diagnostics::Deploy",
      // Opens the project's diagnostics, where Alt+PgDn moves on
      "alt-shift-pagedown": "diagnostics::Deploy",
      "alt-shift-f2": "diagnostics::Deploy",
      "alt-shift-pageup": "diagnostics::Deploy",
      "alt-shift-l": "pane::RevealInProjectPanel",
      // Takes Shift+Alt+Right, macOS's select word
      "alt-shift-right": "workspace::ActivateNextPane",
      // Takes Alt+Right from Zed's word motion
      "alt-right": "pane::ActivateNextItem",
      // Takes Alt+Left from Zed's word motion
      "alt-left": "pane::ActivatePreviousItem",
      "alt-shift-left": "workspace::ActivatePreviousPane",
      // Ctrl+Cmd+F stays Zed's too
      "alt-shift-enter": "zed::ToggleFullScreen",
      "alt-f1": "pane::RevealInProjectPanel",
      "f3": "git_panel::ToggleFocus",
      "alt-3": "git_panel::ToggleFocus",
      "f1": "project_panel::ToggleFocus",
      "alt-1": "project_panel::ToggleFocus",
      "f2": "terminal_panel::Toggle",
      "alt-2": "terminal_panel::Toggle",
      // The log: Zed's git graph; replaces Zed's F4, debugger start, which Alt+Shift+F9 keeps
      "f4": "git_graph::Open",
      "alt-4": "git_graph::Open",
      "alt-x": "git::Branch",
      "alt-z": "git::Fetch",
      "alt-v": "git::Push",
      "alt-shift-f9": "debugger::Start",
      // The last task
      "shift-f5": "task::Rerun",
      "alt-f5": "debugger::Stop",
      "alt-)": "zed::ResetUiFontSize",
      // Fires as the second Shift is released
      "shift shift": "command_palette::Toggle"
    }
  },
  // A new terminal opens on Cmd+T, which the editor and the terminal bind, and not on Ctrl+~.
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-~": "workspace::NewTerminal"
    }
  },
  // Editing, in every editor, the one-line ones too.
  {
    "context": "Editor",
    "bindings": {
      // Replaces Zed's line duplicate up
      "alt-shift-up": "editor::AddSelectionAbove",
      // Replaces Zed's line duplicate down
      "alt-shift-down": "editor::AddSelectionBelow",
      "alt-+": "editor::SelectLargerSyntaxNode",
      "alt-_": "editor::SelectSmallerSyntaxNode",
      "alt-:": "editor::SelectAllMatches",
      "alt->": ["editor::SelectNext", { "replace_newest": false }],
      // Undoes the last selection change
      "alt-<": "editor::UndoSelection",
      "alt-shift-g": "editor::SplitSelectionIntoLines",
      // A terminal tab beside the editor's; replaces Zed's project symbols
      "cmd-t": "workspace::NewCenterTerminal"
    }
  },
  // Code, in the full editor alone, so that search bars and pickers keep their keys.
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-}": "editor::SelectEnclosingSymbol",
      // One kind of completion
      "alt-shift-space": "editor::ShowCompletions",
      // Words of the buffer; takes Alt+/ from which-key in the editor
      "alt-/": "editor::ShowWordCompletions",
      "alt-{": "editor::MoveToStartOfLargerSyntaxNode",
      // Where the server gives a docs link
      "shift-f1": "editor::OpenDocs",
      // Replaces Zed's Shift+F12, which goes to implementations
      // Shift+Alt+F12 is Zed's; a multibuffer, not a popup
      "shift-f12": "editor::FindAllReferences",
      // F12 stays Zed's too
      "alt-d": "editor::GoToDefinition",
      // gopls lists a method's interfaces too; C# goes down alone
      "alt-home": "editor::GoToImplementation",
      "alt-\\": "outline::Toggle",
      // The server's code actions, of every kind
      // Alt+Insert: a Mac keyboard has no Insert
      "alt-enter": "editor::ToggleCodeActions",
      "alt-pagedown": "editor::GoToDiagnostic",
      "alt-pageup": "editor::GoToPreviousDiagnostic",
      // F13 alone: a Mac has no menu key
      "f13": "editor::OpenContextMenu",
      // Replaces Zed's F8, which goes to the next diagnostic
      "f8": "editor::GoToHunk",
      // Replaces Zed's Shift+F8
      "shift-f8": "editor::GoToPreviousHunk",
      "shift-f7": "editor::GoToPreviousHunk",
      // A log message; conditions from the gutter's menu
      "alt-f9": "editor::EditLogBreakpoint"
    }
  },
  // The project panel; F1 hides it again.
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "f1": "workspace::CloseActiveDock",
      "alt-1": "workspace::CloseActiveDock"
    }
  },
  // The git panel; F3 hides it again.
  {
    "context": "GitPanel",
    "bindings": {
      "f3": "workspace::CloseActiveDock",
      "alt-3": "workspace::CloseActiveDock"
    }
  },
  // The git graph, a tab; F4 closes it again. Focus starts in its search field, an Editor below
  // GitGraph, where the global F4 would win. The parentheses hold, as > binds looser than ||.
  {
    "context": "GitGraph || (GitGraph > Editor)",
    "bindings": {
      "f4": "pane::CloseActiveItem",
      "alt-4": "pane::CloseActiveItem"
    }
  },
  // The commit message.
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      // Commits; push stays separate
      "alt-c": "git::Commit",
      "alt-a": "git::Amend"
    }
  },
  // A stopped debug session: the step keys, so Alt keys type otherwise.
  {
    "context": "Workspace && debugger_stopped",
    "bindings": {
      // The selection, in the console
      "alt-f": "debugger::EvaluateSelectedText",
      "alt-r": "debugger::RunToCursor",
      "alt-e": "debugger::StepInto",
      "alt-q": "debugger::StepOut",
      "alt-w": "debugger::StepOver"
    }
  },
  // The terminal: an Alt key with a letter or sign, without Shift, reaches the shell, but for the
  // global keys.
  {
    "context": "Terminal",
    "bindings": {
      // A tab beside this terminal's, in the panel or in the center
      "cmd-t": "workspace::NewTerminal",
      // In the terminal, it closes the dock
      "f2": "workspace::CloseActiveDock",
      "alt-2": "workspace::CloseActiveDock"
    }
  }
  // The keys left out, so that a sync doesn't retry them.
  // alt-up: Alt+Up is Zed's on macOS.
  // alt-down: Alt+Down is Zed's on macOS.
  // alt-f12: no popup: Zed's Alt+F12 opens it in a split.
]
