# The secrets' units: fnox and age-plugin-yubikey, which mise installs for the tree alone, copied
# where every shell finds them. README.md says why they stand there.

# fnox's copy goes in /usr/local/bin, which /etc/paths puts on every shell's, root:wheel and 0755,
# as gh's does, under a temporary name first. With no fnox of mise's this unit alone fails. The
# check runs as the user.
[state.fnox.run]
user = "root"
command = [
    "sh",
    "-c",
    "test -x \"$1\" && mkdir -p /usr/local/bin && install -o root -g wheel -m 0755 \"$1\" /usr/local/bin/.fnox.new && mv -f /usr/local/bin/.fnox.new /usr/local/bin/fnox",
    "sh",
    "{{ .Secrets.FnoxFrom }}",
]
check = [
    "sh",
    "-c",
    "cmp -s \"$1\" /usr/local/bin/fnox && [ \"$(stat -f %u:%g:%Lp /usr/local/bin/fnox)\" = 0:0:755 ]",
    "sh",
    "{{ .Secrets.FnoxFrom }}",
]

# age-plugin-yubikey beside fnox, as fnox runs it from PATH for the Nano's recipient, alike.
[state.age-plugin-yubikey.run]
user = "root"
command = [
    "sh",
    "-c",
    "test -x \"$1\" && mkdir -p /usr/local/bin && install -o root -g wheel -m 0755 \"$1\" /usr/local/bin/.age-plugin-yubikey.new && mv -f /usr/local/bin/.age-plugin-yubikey.new /usr/local/bin/age-plugin-yubikey",
    "sh",
    "{{ .Secrets.PluginFrom }}",
]
check = [
    "sh",
    "-c",
    "cmp -s \"$1\" /usr/local/bin/age-plugin-yubikey && [ \"$(stat -f %u:%g:%Lp /usr/local/bin/age-plugin-yubikey)\" = 0:0:755 ]",
    "sh",
    "{{ .Secrets.PluginFrom }}",
]
