# The Mac's frame's own unit. A LaunchDaemon run by root must trust the ws it runs. mise runs
# /usr/local/bin/ws itself, the file install.sh writes. This unit keeps its owner and mode,
# root:wheel and 0755, with no copy. Its line sits at the root, so that a run from /opt/ws calls the
# read hook too. The check runs as the user, as each read on the Mac does. A missing file fails the
# run and names install.sh.
[state.ws-binary.run]
user = "root"
command = [
    "sh",
    "-c",
    "[ -e /usr/local/bin/ws ] || { echo '/usr/local/bin/ws is missing: install.sh writes it' >&2; exit 1; }; chown 0:0 /usr/local/bin/ws && chmod 0755 /usr/local/bin/ws",
]
check = [
    "sh",
    "-c",
    "[ \"$(stat -f %u:%g:%Lp /usr/local/bin/ws)\" = 0:0:755 ]",
]
