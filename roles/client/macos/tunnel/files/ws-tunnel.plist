<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A server's tunnel LaunchDaemon, which ws client macos apply copies to /Library/LaunchDaemons with
  @NAME@ the server's name: launchd runs `ws client macos tunnel run` for it as root from
  boot, before any login, starts it again 10 s after it exits, and appends its output to
  /var/log/ws-tunnel.@NAME@.log.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.zadykian.ws-tunnel.@NAME@</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/ws-tunnel/ws</string>
		<string>client</string>
		<string>macos</string>
		<string>tunnel</string>
		<string>run</string>
		<string>--server</string>
		<string>@NAME@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/log/ws-tunnel.@NAME@.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ws-tunnel.@NAME@.log</string>
</dict>
</plist>
