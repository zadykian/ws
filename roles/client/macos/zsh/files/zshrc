# Written by ws client macos apply: its next run replaces changes made here.
#
# ~/.zshrc sources this file. tmux, Fresh and cld's sessions turn modes on in the terminal, and a
# dropped ssh leaves them on: the mouse would type escape codes at the prompt. So, before each
# prompt, the hook turns them off (roles/client/macos/ghostty/README.md).

# The reports of the mouse, focus and the colour scheme; modifyOtherKeys and kitty's flags; cursor
# keys and keypad; the cursor's style and visibility.
ws_modes=$'\e[?1000l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1015l\e[?1004l\e[?2031l'
ws_modes+=$'\e[>4m\e[<99u\e[=0;1u\e[?1l\e>\e[0 q\e[?25h'
# The alternate screen's reset restores the main screen's cursor even where that screen is on. So
# ESC 7 saves the spot first, as the saved cursor is the screen's own.
ws_screen=$'\e7\e[?1049l'

# The alternate screen's reset follows a drop alone: an exit of 255 from ssh, or from cld with
# --host, which becomes ssh. Its ESC 7 takes the slot of a cursor that a program saved. Kitty's
# flags are each screen's own, so the modes go on both sides of the reset.
ws_preexec() {
    ws_ssh=
    [[ $2 == ssh || $2 == 'ssh '* || $2 == 'cld '*' --host'* ]] && ws_ssh=1
}

ws_precmd() {
    (($? == 255)) && [[ -n $ws_ssh ]] && print -rn -- "$ws_modes$ws_screen"
    print -rn -- "$ws_modes"
    ws_ssh=
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec ws_preexec
add-zsh-hook precmd ws_precmd
