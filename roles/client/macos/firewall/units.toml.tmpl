# The Application Firewall, on and blocking all incoming connections, so that the server, which
# reaches the Mac over the cable and wg0 past no router, opens none. socketfilterfw's get options
# exit 0 whatever the state, so the check reads their text as the user, and a run that changes
# nothing asks no password. On macOS 26, --getglobalstate's line ends in "(State = 2)" where the
# firewall blocks all, and in "State = 1" where it only filters. Then --getblockall's line says
# "blocking all".
[state.firewall.run]
user = "root"
command = ["/usr/libexec/ApplicationFirewall/socketfilterfw", "--setglobalstate", "on", "--setblockall", "on"]
check = [
    "sh",
    "-c",
    "/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate | grep -Eq 'State = [12]' && /usr/libexec/ApplicationFirewall/socketfilterfw --getblockall | grep -q 'blocking all'",
]
