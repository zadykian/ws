# ssh's units. /etc/ws/ssh_config holds a Host for each server, through the tunnel, and ~/.ssh/config
# includes it at its top. README.md says why each stands.

# ws's copies of the .pubs of Secretive's keys that values.yml names, in /etc/ws/secretive, which
# ssh and git name. macOS keeps ws from reading them in Secretive's container, so ws copies each
# from the agent. A key in a file has none. The command writes through sudo where a copy differs.
[state.keys.run]
user = "{{ .User }}"
command = ["{{ self }}", "client", "keys"]
check = ["{{ self }}", "client", "keys", "--check"]

# ~/.ssh, the user's and 0700, where missing, as ssh-keygen and ssh make it.
[state.ssh-dir.run]
user = "{{ .User }}"
creates = ["{{ .Home }}/.ssh"]
command = ["mkdir", "-m", "700", "{{ .Home }}/.ssh"]

# The servers' hosts, root's and readable by all (facts.SSH). The facts checked the text as ssh
# reads it whole, with ~/.ssh/config; ssh checks the new file alone once more before it goes in.
[file.ssh-config]
after = "state/keys"
path = "/etc/ws/ssh_config"
template = "files/ssh_config.tmpl"
check = ["ssh", "-G", "-F", "{}", "localhost"]

# The Include, first in ~/.ssh/config, which stays the user's: ssh takes a setting's first value,
# so the servers' hosts win over a Host * of the user's. has refuses an Include below a setting, and
# leaves the file untouched. The old file stays as PATH.TIME~, and a link there stops the unit.
[file.ssh-include]
after = "state/ssh-dir"
path = "{{ .Home }}/.ssh/config"
owner = "{{ .User }}"
mode = 0o600
line = "Include /etc/ws/ssh_config"
has = ["{{ self }}", "client", "ssh", "included"]
