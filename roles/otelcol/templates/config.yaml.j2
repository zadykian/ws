# Written by github.com/zadykian/ws, whose next run replaces any change made here.
#
# It starts from SigNoz's config for a collector on a VM, with every port on loopback, the journal
# and node_exporter's temperatures added, and the per-process metrics left out. Where ~/.secrets/env
# sets OTEL_CLAUDE_EXPORTER_OTLP_ENDPOINT, claude's metrics go there too.

extensions:
  health_check:
    endpoint: 127.0.0.1:13133

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:4317
      http:
        endpoint: 127.0.0.1:4318
  # Through the host's journalctl, from the journal's end at each start. rsyslog's files under
  # /var/log repeat the journal, so they are not read.
  journald:
    priority: info
    # MESSAGE becomes the body and PRIORITY the severity, and the other fields become attributes,
    # such as journald._SYSTEMD_UNIT, the unit: otherwise the whole entry is the body. _PID, _EXE
    # and _CMDLINE become the resource's process.* attributes, which resource/journald removes.
    convert_to_semantic_conventions: true
  host_metrics:
    collection_interval: 60s
    scrapers:
      cpu: {}
      load: {}
      memory: {}
      paging: {}
      disk: {}
      filesystem: {}
      network: {}
      processes: {}
  # Temperatures and fans, which host_metrics doesn't read, from node_exporter on loopback, which
  # serves only its hwmon and thermal_zone collectors. A VM has none of either.
  prometheus:
    config:
      scrape_configs:
        - job_name: node
          scrape_interval: 60s
          static_configs:
            - targets: [127.0.0.1:9100]

processors:
  # Past 384 MiB (512 less the spike), the collector refuses new data, as when SigNoz is down and
  # the exporter's queue fills, rather than grow until the kernel kills another process.
  memory_limiter:
    check_interval: 1s
    limit_mib: 512
    spike_limit_mib: 128
  # A resource per process that writes to the journal would fill SigNoz's table of resources,
  # which expects few of them.
  resource/journald:
    attributes:
      - key: process.pid
        action: delete
      - key: process.command_line
        action: delete
      - key: process.executable.path
        action: delete
      - key: process.executable.name
        action: delete
  # host.name, which SigNoz's Host dashboard filters on, from the kernel's hostname rather than DNS.
  resource_detection:
    detectors: [system]
    system:
      hostname_sources: [os]
  batch:
    send_batch_size: 1000
    timeout: 10s
{% if otelcol_claude_endpoint.stdout %}
  # Only claude's metrics: those of any other resource, or of one without service.name, are dropped.
  filter/claude:
    metric_conditions:
      - resource.attributes["service.name"] != "claude-code"
{% endif %}

exporters:
  # SigNoz's intake, which the signoz role publishes on loopback.
  otlp_http/signoz:
    endpoint: http://127.0.0.1:14318
{% if otelcol_claude_endpoint.stdout %}
  # The remote collector, whose URL is only in the service's environment, from a file root alone
  # reads.
  otlp_grpc/claude:
    endpoint: ${env:OTEL_CLAUDE_EXPORTER_OTLP_ENDPOINT}
{%   if otelcol_claude_endpoint.stdout is match('http://') %}
    # gRPC goes over TLS unless told not to, whatever the URL's scheme.
    tls:
      insecure: true
{%   endif %}
{% endif %}

service:
  # The collector's own metrics would listen on 127.0.0.1:8888.
  telemetry:
    metrics:
      level: none
  extensions: [health_check]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, resource_detection, batch]
      exporters: [otlp_http/signoz]
    metrics:
      receivers: [otlp, host_metrics, prometheus]
      processors: [memory_limiter, resource_detection, batch]
      exporters: [otlp_http/signoz]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, resource_detection, batch]
      exporters: [otlp_http/signoz]
    logs/journald:
      receivers: [journald]
      processors: [memory_limiter, resource/journald, resource_detection, batch]
      exporters: [otlp_http/signoz]
{% if otelcol_claude_endpoint.stdout %}
    # claude's metrics as claude sends them: resource_detection adds host.name to a copy of its own,
    # in the metrics pipeline above.
    metrics/claude:
      receivers: [otlp]
      processors: [memory_limiter, filter/claude, batch]
      exporters: [otlp_grpc/claude]
{% endif %}
